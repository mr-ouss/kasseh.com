# 1Password Secrets Reference for Deployment
#
# Setup Instructions:
# 1. Create a 1Password vault for your app (e.g., "MyApp")
# 2. Replace "Kasseh.com" below with your vault name
# 3. Create items in 1Password with the exact names referenced below
# 4. Add OP_SERVICE_ACCOUNT_TOKEN to GitHub Secrets
#
# Format: VARIABLE_NAME=op://VaultName/ItemName/field
# Learn more: https://developer.1password.com/docs/cli/secrets-reference-syntax

# Rails Configuration
RAILS_MASTER_KEY=op://Kasseh.com/rails-master-key/password

# Database (optional - SQLite is default)
# PRODUCTION_DATABASE_URL=op://Kasseh.com/database-url/connection

# Deployment SSH Key (for Kamal)
KAMAL_SSH_KEY=op://Kasseh.com/deploy-ssh-key/private key

# Email/SMTP Configuration
SMTP_USERNAME=op://Kasseh.com/smtp-credentials/username
SMTP_PASSWORD=op://Kasseh.com/smtp-credentials/password
SMTP_SERVER=op://Kasseh.com/smtp-credentials/server
SMTP_FROM_EMAIL=op://Kasseh.com/smtp-credentials/from_email

# OAuth Provider Credentials
GOOGLE_CLIENT_ID=op://Kasseh.com/google-oauth-app/client_id
GOOGLE_CLIENT_SECRET=op://Kasseh.com/google-oauth-app/credential

APPLE_CLIENT_ID=op://Kasseh.com/apple-oauth-app/client_id
APPLE_TEAM_ID=op://Kasseh.com/apple-oauth-app/team_id
APPLE_KEY_ID=op://Kasseh.com/apple-oauth-app/key_id
APPLE_PRIVATE_KEY=op://Kasseh.com/apple-oauth-app/private_key

# Add your own secrets below
# CUSTOM_API_KEY=op://Kasseh.com/api-credentials/key
