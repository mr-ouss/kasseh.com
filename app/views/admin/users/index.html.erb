<% content_for :title, "Admin: Users · RailsRocket" %>
<% content_for :skip_navigation, true %>
<% content_for :body_class, "" %>

<div class="dashboard dashboard--wide">
  <%= render "shared/dashboard_nav" %>

  <main class="dashboard-main">
    <div class="dashboard-content dashboard-content--wide">
      <%= tag.div(flash[:notice], class: "alert alert--success") if flash[:notice] %>
      <%= tag.div(flash[:alert], class: "alert alert--error") if flash[:alert] %>

      <!-- Admin Navigation Tabs -->
      <div class="admin-tabs">
        <%= link_to "Dashboard", admin_root_path, 
            class: "admin-tabs__tab" %>
        <%= link_to "Users", admin_users_path, 
            class: "admin-tabs__tab admin-tabs__tab--active" %>
      </div>

      <div class="admin-header">
        <div>
          <h1 class="admin-header__title">User Management</h1>
          <p class="admin-header__subtitle">Total: <%= @users.total_count %> users</p>
        </div>
        
        <div class="admin-header__actions">
          <%= form_with url: admin_users_path, method: :get, class: "admin-search" do |form| %>
            <%= form.text_field :query, 
                value: params[:query], 
                placeholder: "Search by email...", 
                class: "admin-search__input" %>
            <%= form.submit "Search", class: "button button--primary button--sm" %>
          <% end %>
        </div>
      </div>

      <!-- Filter tabs -->
      <div class="admin-tabs">
        <%= link_to "All Users", admin_users_path, 
            class: "admin-tabs__tab #{params[:filter].blank? ? 'admin-tabs__tab--active' : ''}" %>
        <%= link_to "Admins", admin_users_path(filter: "admins"), 
            class: "admin-tabs__tab #{params[:filter] == 'admins' ? 'admin-tabs__tab--active' : ''}" %>
        <%= link_to "Regular Users", admin_users_path(filter: "regular"), 
            class: "admin-tabs__tab #{params[:filter] == 'regular' ? 'admin-tabs__tab--active' : ''}" %>
      </div>

      <!-- Users table -->
      <div class="admin-table-wrapper">
        <table class="admin-table">
          <thead>
            <tr>
              <th>User</th>
              <th>Auth Method</th>
              <th>Role</th>
              <th>Signed Up</th>
              <th>Last Login</th>
              <th>Activities</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @users.each do |user| %>
              <tr class="<%= 'admin-table__row--highlight' if user.admin? %>">
                <td class="admin-table__user">
                  <%= link_to admin_user_path(user), class: "admin-table__user-link" do %>
                    <div class="admin-table__user-email"><%= user.email_address %></div>
                    <div class="admin-table__user-name"><%= user.full_name %></div>
                  <% end %>
                </td>
                <td>
                  <% if user.oauth_user? %>
                    <% case user.provider.downcase %>
                    <% when 'google_oauth2', 'google' %>
                      <span class="badge badge--auth-google">Google</span>
                    <% when 'apple' %>
                      <span class="badge badge--auth-apple">Apple</span>
                    <% when 'github' %>
                      <span class="badge badge--auth-github">GitHub</span>
                    <% else %>
                      <span class="badge badge--info"><%= user.provider.titleize %></span>
                    <% end %>
                  <% else %>
                    <span class="badge badge--auth-email">Email</span>
                  <% end %>
                </td>
                <td>
                  <% if user.admin? %>
                    <% if user.primary_admin? %>
                      <span class="badge badge--info" title="Protected primary admin account">🛡️ Super Admin</span>
                    <% else %>
                      <span class="badge badge--success">Admin</span>
                    <% end %>
                  <% else %>
                    <span class="badge badge--default">User</span>
                  <% end %>
                </td>
                <td class="admin-table__date">
                  <%= time_ago_in_words(user.created_at) %> ago
                </td>
                <td class="admin-table__date">
                  <% if user.last_login_at %>
                    <%= time_ago_in_words(user.last_login_at) %> ago
                  <% else %>
                    <span class="text-muted">Never</span>
                  <% end %>
                </td>
                <td class="admin-table__center">
                  <%= user.total_activities %>
                </td>
                <td class="admin-table__actions">
                  <%= link_to "👁️", admin_user_path(user), class: "action-icon action-icon--view", title: "View Details" %>
                  
                  <% if user.id != Current.user.id && !user.primary_admin? %>
                    <% if user.admin? %>
                      <%= link_to "⬇️", remove_admin_admin_user_path(user), 
                          method: :delete,
                          class: "action-icon action-icon--demote",
                          title: "Remove Admin",
                          data: { 
                            turbo_method: :delete,
                            turbo_confirm: "Remove admin privileges from #{user.email_address}?" 
                          } %>
                    <% else %>
                      <%= link_to "⬆️", make_admin_admin_user_path(user), 
                          method: :post,
                          class: "action-icon action-icon--promote",
                          title: "Make Admin",
                          data: { 
                            turbo_method: :post,
                            turbo_confirm: "Grant admin privileges to #{user.email_address}?" 
                          } %>
                    <% end %>
                    
                    <%= link_to "🗑️", admin_user_path(user), 
                        method: :delete,
                        class: "action-icon action-icon--delete",
                        title: "Delete User",
                        data: { 
                          turbo_method: :delete,
                          turbo_confirm: "Delete #{user.email_address}? This will permanently delete their account and all data." 
                        } %>
                  <% else %>
                    <!-- Spacer for alignment -->
                    <span class="action-icon-spacer"></span>
                    <span class="action-icon-spacer"></span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <!-- Pagination -->
      <div class="admin-pagination">
        <%= paginate @users %>
      </div>
    </div>
  </main>
</div>
