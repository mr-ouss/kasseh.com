<% content_for :title, "Sign In · Kasseh" %>
<% content_for :skip_navigation, true %>
<% content_for :body_class, "auth-page-body" %>

<div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-charcoal-900 via-charcoal-800 to-charcoal-900 px-4 py-12">
  <div class="w-full max-w-md">
    <!-- Logo -->
    <div class="text-center mb-8">
      <%= link_to root_path, class: "inline-block" do %>
        <%= image_tag "kasseh-logo.png", alt: "Kasseh", class: "w-20 h-20 mx-auto opacity-90 hover:opacity-100 transition-opacity duration-300 mb-4" %>
        <h2 class="text-2xl font-sans font-bold text-white tracking-wide">KASSEH</h2>
      <% end %>
    </div>

    <!-- Auth Card -->
    <div class="bg-white/10 backdrop-blur-md border border-charcoal-700/50 rounded-lg shadow-2xl p-8">
      <div class="mb-6 text-center">
        <h1 class="text-2xl font-sans font-bold text-white mb-2">Welcome back</h1>
        <p class="text-charcoal-300">Sign in to your account</p>
      </div>

      <%= tag.div(flash[:alert], class: "mb-4 p-4 bg-red-500/20 border border-red-500/50 rounded-md text-red-200 text-sm") if flash[:alert] %>
      <%= tag.div(flash[:notice], class: "mb-4 p-4 bg-green-500/20 border border-green-500/50 rounded-md text-green-200 text-sm") if flash[:notice] %>

      <!-- OAuth Sign-in Options -->
      <div class="space-y-3 mb-6">
        <%= button_to "/auth/google_oauth2", method: :post, class: "w-full flex items-center justify-center space-x-3 bg-white hover:bg-gray-50 text-gray-700 font-medium py-3 px-4 rounded-md transition-colors duration-300", data: { turbo: false } do %>
          <svg class="w-5 h-5" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
          </svg>
          <span>Continue with Google</span>
        <% end %>

        <% if ENV["APPLE_CLIENT_ID"].present? %>
          <%= button_to "/auth/apple", method: :post, class: "w-full flex items-center justify-center space-x-3 bg-black hover:bg-gray-900 text-white font-medium py-3 px-4 rounded-md transition-colors duration-300", data: { turbo: false } do %>
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09l.01-.01zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/>
            </svg>
            <span>Continue with Apple</span>
          <% end %>
        <% end %>
      </div>

      <div class="relative mb-6">
        <div class="absolute inset-0 flex items-center">
          <div class="w-full border-t border-charcoal-700"></div>
        </div>
        <div class="relative flex justify-center text-sm">
          <span class="px-4 bg-charcoal-800/50 text-charcoal-400">or continue with email</span>
        </div>
      </div>

      <%= form_with url: session_path, class: "space-y-4", data: { turbo: false } do |form| %>
        <div>
          <%= form.label :email_address, "Email address", class: "block text-sm font-medium text-charcoal-200 mb-2" %>
          <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: "you@kasseh.com", value: params[:email_address], class: "w-full px-4 py-3 bg-white/10 border border-charcoal-700 rounded-md text-white placeholder-charcoal-500 focus:outline-none focus:ring-2 focus:ring-gold-500 focus:border-transparent transition-all duration-300" %>
        </div>

        <div>
          <%= form.label :password, "Password", class: "block text-sm font-medium text-charcoal-200 mb-2" %>
          <%= form.password_field :password, required: true, autocomplete: "current-password", placeholder: "Enter your password", maxlength: 72, class: "w-full px-4 py-3 bg-white/10 border border-charcoal-700 rounded-md text-white placeholder-charcoal-500 focus:outline-none focus:ring-2 focus:ring-gold-500 focus:border-transparent transition-all duration-300" %>
        </div>

        <%= form.submit "Sign in", class: "w-full bg-gold-600 hover:bg-gold-700 text-white font-semibold py-3 px-4 rounded-md transition-colors duration-300 cursor-pointer" %>
      <% end %>

      <div class="mt-6 text-center text-sm">
        <%= link_to "Forgot password?", new_password_path, class: "text-gold-500 hover:text-gold-400 transition-colors duration-300" %>
        <span class="text-charcoal-500 mx-2">·</span>
        <span class="text-charcoal-400">Don't have an account?</span>
        <%= link_to "Sign up", new_registration_path, class: "text-gold-500 hover:text-gold-400 transition-colors duration-300" %>
      </div>
    </div>

    <div class="mt-8 text-center">
      <%= link_to root_path, class: "inline-flex items-center text-charcoal-400 hover:text-white transition-colors duration-300" do %>
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        Back to home
      <% end %>
    </div>
  </div>
</div>
