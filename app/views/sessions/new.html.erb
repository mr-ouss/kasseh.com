<% content_for :title, "Sign In · Kasseh" %>
<% content_for :skip_navigation, true %>
<% content_for :body_class, "auth-page-body" %>

<div class="min-h-screen relative overflow-hidden">
  <!-- Multi-layer Animated Background -->
  <div class="fixed inset-0">
    <div class="absolute inset-0 bg-gradient-to-br from-charcoal-950 via-charcoal-900 to-charcoal-950"></div>
    <div class="absolute inset-0 opacity-30">
      <div class="gradient-orb gradient-orb-1"></div>
      <div class="gradient-orb gradient-orb-2"></div>
      <div class="gradient-orb gradient-orb-3"></div>
    </div>
    <canvas id="particles" class="absolute inset-0"></canvas>
  </div>
  <div id="spotlight" class="fixed inset-0 pointer-events-none opacity-0 transition-opacity duration-1000"></div>
  <div class="fixed inset-0 bg-gradient-radial-custom opacity-60 pointer-events-none"></div>

  <!-- Content -->
  <div class="relative z-10 min-h-screen flex items-center justify-center px-4 py-12">
  <div class="w-full max-w-md">
    <!-- Logo -->
    <div class="text-center mb-8">
      <%= link_to root_path, class: "inline-block" do %>
        <%= image_tag "kasseh-logo.png", alt: "Kasseh", class: "w-20 h-20 mx-auto opacity-90 hover:opacity-100 transition-opacity duration-300 mb-4" %>
        <h2 class="text-2xl font-sans font-bold text-white tracking-wide">KASSEH</h2>
      <% end %>
    </div>

    <!-- Auth Card -->
    <div class="bg-charcoal-800/40 backdrop-blur-xl border border-gold-600/20 rounded-lg shadow-2xl p-8">
      <div class="mb-6 text-center">
        <h1 class="text-2xl font-sans font-bold text-white mb-2">Welcome back</h1>
        <p class="text-charcoal-300">Sign in to your account</p>
      </div>

      <%= tag.div(flash[:alert], class: "mb-4 p-4 bg-red-500/20 border border-red-500/50 rounded-md text-red-200 text-sm") if flash[:alert] %>
      <%= tag.div(flash[:notice], class: "mb-4 p-4 bg-green-500/20 border border-green-500/50 rounded-md text-green-200 text-sm") if flash[:notice] %>

      <!-- OAuth Sign-in Options -->
      <div class="space-y-3 mb-6">
        <form action="/auth/google_oauth2" method="post" data-turbo="false" class="w-full">
          <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
          <button type="submit" class="group relative w-full overflow-hidden bg-charcoal-900/50 hover:bg-charcoal-900/70 border border-gold-600/30 text-white font-medium py-3.5 px-6 rounded-lg transition-all duration-300 shadow-md hover:shadow-xl hover:-translate-y-0.5">
            <div class="flex items-center justify-center gap-3">
              <svg class="w-5 h-5 transition-transform duration-300 group-hover:scale-110" viewBox="0 0 24 24">
                <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
              </svg>
              <span class="font-semibold">Continue with Google</span>
            </div>
            <div class="absolute inset-0 bg-gradient-to-r from-transparent via-gold-500/10 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-1000"></div>
          </button>
        </form>

        <% if ENV["APPLE_CLIENT_ID"].present? %>
          <form action="/auth/apple" method="post" data-turbo="false" class="w-full">
            <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
            <button type="submit" class="group relative w-full overflow-hidden bg-charcoal-950 hover:bg-black border border-charcoal-700/50 text-white font-medium py-3.5 px-6 rounded-lg transition-all duration-300 shadow-md hover:shadow-xl hover:-translate-y-0.5">
              <div class="flex items-center justify-center gap-3">
                <svg class="w-5 h-5 transition-transform duration-300 group-hover:scale-110" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09l.01-.01zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/>
                </svg>
                <span class="font-semibold">Continue with Apple</span>
              </div>
              <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/10 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-1000"></div>
            </button>
          </form>
        <% end %>
      </div>

      <div class="relative mb-6">
        <div class="absolute inset-0 flex items-center">
          <div class="w-full border-t border-gold-600/20"></div>
        </div>
        <div class="relative flex justify-center text-sm">
          <span class="px-4 bg-charcoal-800/80 text-charcoal-400">or continue with email</span>
        </div>
      </div>

      <%= form_with url: session_path, class: "space-y-4", data: { turbo: false } do |form| %>
        <div>
          <%= form.label :email_address, "Email address", class: "block text-sm font-medium text-charcoal-300 mb-2" %>
          <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: "you@kasseh.com", value: params[:email_address], class: "w-full px-4 py-3 bg-charcoal-900/50 border border-gold-600/30 rounded-md text-white placeholder-charcoal-500 focus:outline-none focus:ring-2 focus:ring-gold-500 focus:border-gold-500 transition-all duration-300" %>
        </div>

        <div>
          <%= form.label :password, "Password", class: "block text-sm font-medium text-charcoal-300 mb-2" %>
          <%= form.password_field :password, required: true, autocomplete: "current-password", placeholder: "Enter your password", maxlength: 72, class: "w-full px-4 py-3 bg-charcoal-900/50 border border-gold-600/30 rounded-md text-white placeholder-charcoal-500 focus:outline-none focus:ring-2 focus:ring-gold-500 focus:border-gold-500 transition-all duration-300" %>
        </div>

        <%= form.submit "Sign in", class: "w-full bg-gold-600 hover:bg-gold-500 text-white font-semibold py-3 px-4 rounded-md transition-all duration-300 cursor-pointer shadow-lg hover:shadow-xl hover:scale-[1.02]" %>
      <% end %>

      <div class="mt-6 text-center text-sm">
        <%= link_to "Forgot password?", new_password_path, class: "text-gold-500 hover:text-gold-400 transition-colors duration-300" %>
        <span class="text-charcoal-500 mx-2">·</span>
        <span class="text-charcoal-400">Don't have an account?</span>
        <%= link_to "Sign up", new_registration_path, class: "text-gold-500 hover:text-gold-400 transition-colors duration-300" %>
      </div>
    </div>

    <div class="mt-8 text-center">
      <%= link_to root_path, class: "inline-flex items-center text-charcoal-400 hover:text-gold-500 transition-all duration-300 group" do %>
        <svg class="w-4 h-4 mr-2 transition-transform duration-300 group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        Back to home
      <% end %>
    </div>
  </div>
  </div>
</div>

<style>
  .gradient-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    mix-blend-mode: screen;
    pointer-events: none;
  }
  .gradient-orb-1 {
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(197, 141, 71, 0.15) 0%, transparent 70%);
    top: 10%;
    left: 15%;
    animation: orb-drift-1 25s ease-in-out infinite;
  }
  .gradient-orb-2 {
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(212, 169, 98, 0.1) 0%, transparent 70%);
    bottom: 15%;
    right: 20%;
    animation: orb-drift-2 30s ease-in-out infinite;
  }
  .gradient-orb-3 {
    width: 350px;
    height: 350px;
    background: radial-gradient(circle, rgba(165, 114, 58, 0.12) 0%, transparent 70%);
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    animation: orb-drift-3 35s ease-in-out infinite;
  }
  @keyframes orb-drift-1 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(80px, -40px) scale(1.1); }
    66% { transform: translate(-40px, 80px) scale(0.9); }
  }
  @keyframes orb-drift-2 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(-100px, 60px) scale(0.9); }
    66% { transform: translate(60px, -80px) scale(1.1); }
  }
  @keyframes orb-drift-3 {
    0%, 100% { transform: translate(-50%, -50%) scale(1); }
    33% { transform: translate(calc(-50% + 40px), calc(-50% + 100px)) scale(1.1); }
    66% { transform: translate(calc(-50% - 80px), calc(-50% - 40px)) scale(0.9); }
  }
  .bg-gradient-radial-custom {
    background: radial-gradient(circle at 50% 50%, transparent 0%, rgba(10, 10, 12, 0.4) 50%, rgba(10, 10, 12, 0.8) 100%);
  }
  #spotlight {
    background: radial-gradient(
      600px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
      rgba(212, 169, 98, 0.06),
      transparent 40%
    );
  }
  #spotlight.active { opacity: 1; }
</style>

<script>
  class ParticleSystem {
    constructor(canvas) {
      this.canvas = canvas;
      this.ctx = canvas.getContext('2d');
      this.particles = [];
      this.particleCount = 50;
      this.resize();
      this.init();
      this.animate();
      window.addEventListener('resize', () => this.resize());
    }
    resize() {
      this.canvas.width = window.innerWidth;
      this.canvas.height = window.innerHeight;
    }
    init() {
      this.particles = [];
      for (let i = 0; i < this.particleCount; i++) {
        this.particles.push({
          x: Math.random() * this.canvas.width,
          y: Math.random() * this.canvas.height,
          size: Math.random() * 2 + 0.5,
          speedX: (Math.random() - 0.5) * 0.3,
          speedY: (Math.random() - 0.5) * 0.3,
          opacity: Math.random() * 0.5 + 0.2
        });
      }
    }
    update() {
      this.particles.forEach(particle => {
        particle.x += particle.speedX;
        particle.y += particle.speedY;
        if (particle.x < 0) particle.x = this.canvas.width;
        if (particle.x > this.canvas.width) particle.x = 0;
        if (particle.y < 0) particle.y = this.canvas.height;
        if (particle.y > this.canvas.height) particle.y = 0;
        particle.opacity = 0.2 + Math.sin(Date.now() * 0.001 + particle.x) * 0.2;
      });
    }
    draw() {
      this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);
      this.particles.forEach(particle => {
        this.ctx.beginPath();
        this.ctx.arc(particle.x, particle.y, particle.size, 0, Math.PI * 2);
        this.ctx.fillStyle = `rgba(212, 169, 98, ${particle.opacity})`;
        this.ctx.fill();
      });
      this.particles.forEach((p1, i) => {
        this.particles.slice(i + 1).forEach(p2 => {
          const dx = p1.x - p2.x;
          const dy = p1.y - p2.y;
          const distance = Math.sqrt(dx * dx + dy * dy);
          if (distance < 120) {
            this.ctx.beginPath();
            this.ctx.moveTo(p1.x, p1.y);
            this.ctx.lineTo(p2.x, p2.y);
            const opacity = (1 - distance / 120) * 0.1;
            this.ctx.strokeStyle = `rgba(212, 169, 98, ${opacity})`;
            this.ctx.lineWidth = 0.5;
            this.ctx.stroke();
          }
        });
      });
    }
    animate() {
      this.update();
      this.draw();
      requestAnimationFrame(() => this.animate());
    }
  }
  document.addEventListener('DOMContentLoaded', function() {
    const canvas = document.getElementById('particles');
    if (canvas) new ParticleSystem(canvas);
    const spotlight = document.getElementById('spotlight');
    let isActive = false;
    document.addEventListener('mousemove', (e) => {
      if (!isActive) {
        spotlight.classList.add('active');
        isActive = true;
      }
      spotlight.style.setProperty('--mouse-x', `${e.clientX}px`);
      spotlight.style.setProperty('--mouse-y', `${e.clientY}px`);
    });
  });
</script>
