<% content_for :title, "Sign In · RailsRocket" %>
<% content_for :skip_navigation, true %>
<% content_for :body_class, "" %>

<div class="auth-page">
  <div class="auth-page__container">
    <div class="auth-page__header">
      <%= link_to root_path, class: "auth-page__logo" do %>
        <span class="auth-page__logo-text"><%= ENV.fetch("APP_NAME", "RailsRocket") %></span>
      <% end %>
    </div>

    <div class="auth-page__card">
      <div class="auth-form">
        <h1 class="auth-form__title">Welcome back</h1>
        <p class="auth-form__subtitle">Sign in to your account</p>
        
        <div class="alert alert--info" style="margin-bottom: 1.5rem;">
          <svg style="width: 20px; height: 20px; flex-shrink: 0;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
          </svg>
          <div>
            <strong>Secure by design</strong>
            <p style="margin: 0.25rem 0 0 0; font-size: 0.875rem;">Sign in to access your account and manage your profile securely. Quick and simple, no lengthy forms required.</p>
          </div>
        </div>
        
        <%= tag.div(flash[:alert], class: "alert alert--error") if flash[:alert] %>
        <%= tag.div(flash[:notice], class: "alert alert--success") if flash[:notice] %>

        <!-- OAuth Sign-in Options -->
        <div class="oauth-buttons">
          <%= button_to "/auth/github", method: :post, class: "oauth-button oauth-button--github", data: { turbo: false } do %>
            <svg class="oauth-button__icon" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
            Continue with GitHub
          <% end %>
          
          <%= button_to "/auth/google_oauth2", method: :post, class: "oauth-button oauth-button--google", data: { turbo: false } do %>
            <svg class="oauth-button__icon" viewBox="0 0 24 24">
              <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
              <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
              <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
              <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
            </svg>
            Continue with Google
          <% end %>
          
          <% if ENV["APPLE_CLIENT_ID"].present? %>
            <%= button_to "/auth/apple", method: :post, class: "oauth-button oauth-button--apple", data: { turbo: false } do %>
              <svg class="oauth-button__icon" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09l.01-.01zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/>
              </svg>
              Continue with Apple
            <% end %>
          <% end %>
        </div>

        <div class="auth-form__divider">
          <span>or continue with email</span>
        </div>

        <%= form_with url: session_path, class: "auth-form__form", data: { turbo: false } do |form| %>
          <div class="auth-form__field">
            <%= form.label :email_address, "Email address", class: "auth-form__label" %>
            <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: "you@example.com", value: params[:email_address], class: "auth-form__input" %>
          </div>

          <div class="auth-form__field">
            <%= form.label :password, "Password", class: "auth-form__label" %>
            <%= form.password_field :password, required: true, autocomplete: "current-password", placeholder: "Enter your password", maxlength: 72, class: "auth-form__input" %>
          </div>

          <%= form.submit "Sign in", class: "auth-form__submit" %>
        <% end %>

        <div class="auth-form__footer">
          <%= link_to "Forgot password?", new_password_path, class: "auth-form__link" %> · 
          Don't have an account? <%= link_to "Sign up", new_registration_path, class: "auth-form__link" %>
        </div>
      </div>
    </div>

    <div class="auth-page__footer">
      <%= link_to "← Back to home", root_path, class: "auth-page__back" %>
    </div>
  </div>
</div>

