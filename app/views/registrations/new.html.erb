<% content_for :title, "Sign Up · Kasseh" %>
<% content_for :skip_navigation, true %>
<% content_for :body_class, "auth-page-body" %>

<div class="min-h-screen relative overflow-hidden">
  <div class="fixed inset-0">
    <div class="absolute inset-0 bg-gradient-to-br from-charcoal-950 via-charcoal-900 to-charcoal-950"></div>
    <div class="absolute inset-0 opacity-30">
      <div class="gradient-orb gradient-orb-1"></div>
      <div class="gradient-orb gradient-orb-2"></div>
      <div class="gradient-orb gradient-orb-3"></div>
    </div>
    <canvas id="particles" class="absolute inset-0"></canvas>
  </div>
  <div id="spotlight" class="fixed inset-0 pointer-events-none opacity-0 transition-opacity duration-1000"></div>
  <div class="fixed inset-0 bg-gradient-radial-custom opacity-60 pointer-events-none"></div>
  <div class="relative z-10 min-h-screen flex items-center justify-center px-4 py-12">
  <div class="w-full max-w-md">
    <!-- Logo -->
    <div class="text-center mb-8">
      <%= link_to root_path, class: "inline-block" do %>
        <%= image_tag "kasseh-logo.png", alt: "Kasseh", class: "w-20 h-20 mx-auto opacity-90 hover:opacity-100 transition-opacity duration-300 mb-4" %>
        <h2 class="text-2xl font-sans font-bold text-white tracking-wide">KASSEH</h2>
      <% end %>
    </div>

    <!-- Auth Card -->
    <div class="bg-charcoal-800/40 backdrop-blur-xl border border-gold-600/20 rounded-lg shadow-2xl p-8">
      <div class="mb-6 text-center">
        <h1 class="text-2xl font-sans font-bold text-white mb-2">Create account</h1>
        <p class="text-charcoal-300">Join with your @kasseh.com email</p>
      </div>

      <div class="mb-6 p-4 bg-gold-500/10 border border-gold-500/30 rounded-md">
        <div class="flex items-start space-x-3">
          <svg class="w-5 h-5 text-gold-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
          </svg>
          <div class="text-sm text-gold-200">
            <strong class="block mb-1">Restricted Access</strong>
            <p class="text-gold-300/80 mb-2">Only @kasseh.com email addresses are permitted to create accounts.</p>
            <p class="text-gold-300/80">If you're a Kasseh family member, please email <a href="mailto:support@kasseh.com" class="text-gold-400 hover:text-gold-300 underline transition-colors">support@kasseh.com</a> for assistance.</p>
          </div>
        </div>
      </div>

      <%= tag.div(flash[:alert], class: "mb-4 p-4 bg-red-500/20 border border-red-500/50 rounded-md text-red-200 text-sm") if flash[:alert] %>
      <%= tag.div(flash[:notice], class: "mb-4 p-4 bg-green-500/20 border border-green-500/50 rounded-md text-green-200 text-sm") if flash[:notice] %>

      <%= form_with model: @user, url: registration_path, class: "space-y-4", data: { turbo: false } do |form| %>
        <% if @user.errors.any? %>
          <div class="p-4 bg-red-500/20 border border-red-500/50 rounded-md text-red-200 text-sm">
            <ul class="list-disc list-inside space-y-1">
              <% @user.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div>
          <%= form.label :email_address, "Email address", class: "block text-sm font-medium text-charcoal-300 mb-2" %>
          <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: "you@kasseh.com", class: "w-full px-4 py-3 bg-charcoal-900/50 border border-gold-600/30 rounded-md text-white placeholder-charcoal-500 focus:outline-none focus:ring-2 focus:ring-gold-500 focus:border-gold-500 transition-all duration-300" %>
          <p class="mt-1 text-xs text-charcoal-400">Must be a @kasseh.com email address</p>
        </div>

        <div>
          <%= form.label :password, "Password", class: "block text-sm font-medium text-charcoal-300 mb-2" %>
          <%= form.password_field :password, required: true, autocomplete: "new-password", placeholder: "Enter a secure password", maxlength: 72, class: "w-full px-4 py-3 bg-charcoal-900/50 border border-gold-600/30 rounded-md text-white placeholder-charcoal-500 focus:outline-none focus:ring-2 focus:ring-gold-500 focus:border-gold-500 transition-all duration-300" %>
        </div>

        <div>
          <%= form.label :password_confirmation, "Confirm password", class: "block text-sm font-medium text-charcoal-300 mb-2" %>
          <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", placeholder: "Re-enter your password", maxlength: 72, class: "w-full px-4 py-3 bg-charcoal-900/50 border border-gold-600/30 rounded-md text-white placeholder-charcoal-500 focus:outline-none focus:ring-2 focus:ring-gold-500 focus:border-gold-500 transition-all duration-300" %>
        </div>

        <%= form.submit "Create account", class: "w-full bg-gold-600 hover:bg-gold-500 text-white font-semibold py-3 px-4 rounded-md transition-all duration-300 cursor-pointer shadow-lg hover:shadow-xl hover:scale-[1.02]" %>
      <% end %>

      <div class="mt-6 text-center text-sm">
        <span class="text-charcoal-400">Already have an account?</span>
        <%= link_to "Sign in", new_session_path, class: "text-gold-500 hover:text-gold-400 transition-colors duration-300" %>
      </div>
    </div>

    <div class="mt-8 text-center">
      <%= link_to root_path, class: "inline-flex items-center text-charcoal-400 hover:text-gold-500 transition-all duration-300 group" do %>
        <svg class="w-4 h-4 mr-2 transition-transform duration-300 group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        Back to home
      <% end %>
    </div>
  </div>
  </div>
</div>
<%= render 'shared/auth_scripts' %>
