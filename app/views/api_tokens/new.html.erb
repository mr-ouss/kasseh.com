<% content_for :title, "Generate API Token · RailsRocket" %>
<% content_for :skip_navigation, true %>
<% content_for :body_class, "" %>

<div class="dashboard dashboard--wide">
  <%= render "shared/dashboard_nav" %>

  <main class="dashboard-main">
    <div class="dashboard-content dashboard-content--wide">
      <div class="profile-header">
        <h1 class="profile-header__title">Generate API Token</h1>
        <p class="profile-header__subtitle">Create a new token for programmatic access</p>
      </div>

      <%= form_with model: @api_token, url: api_tokens_path, class: "profile-card" do |form| %>
        <% if @api_token.errors.any? %>
          <div class="alert alert--error" style="margin-bottom: 1.5rem;">
            <strong><%= pluralize(@api_token.errors.count, "error") %> prohibited this token from being saved:</strong>
            <ul style="margin: 0.5rem 0 0 1.5rem;">
              <% @api_token.errors.each do |error| %>
                <li><%= error.full_message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="form-group">
          <%= form.label :name, "Token Name *", class: "form-label" %>
          <%= form.text_field :name, class: "form-input", placeholder: "e.g., Production API, Development, ChatGPT Integration", required: true %>
          <small class="form-help">Give this token a descriptive name to identify its purpose.</small>
        </div>

        <div class="form-group">
          <%= form.label :expires_at, "Expiration Date (Optional)", class: "form-label" %>
          <%= form.date_field :expires_at, class: "form-input", min: Date.today %>
          <small class="form-help">Leave blank for no expiration. Recommended: set an expiration date for security.</small>
        </div>

        <div class="form-actions" style="display: flex; gap: 1rem; margin-top: 1.5rem;">
          <%= form.submit "Generate Token", class: "button button--primary" %>
          <%= link_to "Cancel", api_tokens_path, class: "button button--secondary" %>
        </div>
      <% end %>

      <div class="profile-card" style="margin-top: 2rem;">
        <h2 class="profile-card__title">Security Notes</h2>
        <ul class="profile-card__list">
          <li>Treat API tokens like passwords - never share them publicly</li>
          <li>Tokens are hashed and cannot be recovered if lost</li>
          <li>The token will only be shown once after generation</li>
          <li>Revoke tokens immediately if compromised</li>
          <li>Set expiration dates for added security</li>
        </ul>
      </div>
    </div>
  </main>
</div>
