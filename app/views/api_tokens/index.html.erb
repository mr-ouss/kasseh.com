<% content_for :title, "API Tokens · RailsRocket" %>
<% content_for :skip_navigation, true %>
<% content_for :body_class, "" %>

<div class="dashboard dashboard--wide api-tokens-page">
  <%= render "shared/dashboard_nav" %>

  <main class="dashboard-main">
    <div class="dashboard-content dashboard-content--wide">
      <%= tag.div(flash[:notice], class: "alert alert--success") if flash[:notice] %>
      <%= tag.div(flash[:alert], class: "alert alert--error") if flash[:alert] %>

      <div class="profile-header">
        <div>
          <h1 class="profile-header__title">API Tokens</h1>
          <p class="profile-header__subtitle">Manage API tokens for programmatic access</p>
          <%= link_to profile_path, class: "button button--secondary", style: "margin-top: 1rem; display: inline-block;" do %>
            ← Back to Profile
          <% end %>
        </div>
      </div>

      <% if flash[:api_token] %>
        <div class="alert alert--warning api-token-alert">
          <strong>⚠️ Important:</strong> Copy your API token now. You won't be able to see it again!
          <div class="api-token-display">
            <%= flash[:api_token] %>
          </div>
          <button onclick="navigator.clipboard.writeText('<%= flash[:api_token] %>'); this.textContent='✓ Copied!';" class="button button--primary">
            Copy to Clipboard
          </button>
        </div>
      <% end %>

      <div class="profile-card">
        <div class="profile-card__header">
          <div>
            <h2 class="profile-card__title">Your API Tokens</h2>
            <p class="profile-card__description">Tokens provide secure programmatic access to your connections</p>
          </div>
          <%= link_to new_api_token_path, class: "button button--primary" do %>
            + Generate New Token
          <% end %>
        </div>

        <% if @api_tokens.any? %>
          <div class="api-tokens-list">
            <% @api_tokens.each do |token| %>
              <div class="api-token-item">
                <div class="api-token-item__content">
                  <div class="api-token-item__info">
                    <div class="api-token-item__header">
                      <h3 class="api-token-item__name"><%= token.name %></h3>
                      <% if token.expired? %>
                        <span class="badge badge--danger">⦿ Expired</span>
                      <% else %>
                        <span class="badge badge--success">⦿ Active</span>
                      <% end %>
                    </div>
                    <div class="api-token-item__meta">
                      <span>Created <%= time_ago_in_words(token.created_at) %> ago</span>
                      <span>•</span>
                      <span>
                        Last used:
                        <% if token.last_used_at %>
                          <%= time_ago_in_words(token.last_used_at) %> ago
                        <% else %>
                          <span class="text-muted">Never</span>
                        <% end %>
                      </span>
                      <% if token.expires_at %>
                        <span>•</span>
                        <span>Expires <%= token.expires_at.strftime("%b %d, %Y") %></span>
                      <% end %>
                    </div>
                  </div>
                  <%= button_to api_token_path(token), method: :delete,
                      data: { turbo_confirm: "Are you sure you want to revoke this token? This cannot be undone." },
                      class: "button button--danger button--sm" do %>
                    Revoke
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="empty-state">
            <div class="empty-state__icon">🔑</div>
            <h3 class="empty-state__title">No API Tokens Yet</h3>
            <p class="empty-state__description">Generate a token to start using the API</p>
          </div>
        <% end %>
      </div>

      <div class="profile-card api-docs-card">
        <details class="api-docs-details">
          <summary class="api-docs-summary">
            📖 API Documentation
          </summary>
          
          <div class="api-docs-content">
            <p class="api-docs-intro">
              Include your API token in requests using either authentication method below.
            </p>
            
            <div class="api-docs-section">
              <h3 class="api-docs-section__title">Bearer Token</h3>
              <pre class="code-block"><code>Authorization: Bearer YOUR_TOKEN</code></pre>
            </div>

            <div class="api-docs-section">
              <h3 class="api-docs-section__title">API Key Header</h3>
              <pre class="code-block"><code>X-API-Key: YOUR_TOKEN</code></pre>
            </div>

            <div class="api-docs-section">
              <h3 class="api-docs-section__title">Example Request</h3>
              <pre class="code-block"><code>curl -H "Authorization: Bearer YOUR_TOKEN" \
     <%= request.base_url %>/api/v1/file_transfers/CONNECTION_ID/list?path=/</code></pre>
            </div>
          </div>
        </details>
      </div>
    </div>
  </main>
</div>
