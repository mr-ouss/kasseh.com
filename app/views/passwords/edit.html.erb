<% content_for :title, "Reset Password · RailsRocket" %>
<% content_for :skip_navigation, true %>
<% content_for :body_class, "" %>

<div class="auth-page">
  <div class="auth-page__container">
    <div class="auth-page__header">
      <%= link_to root_path, class: "auth-page__logo" do %>
        <span class="auth-page__logo-text"><%= ENV.fetch("APP_NAME", "RailsRocket") %></span>
      <% end %>
    </div>

    <div class="auth-page__card">
      <div class="auth-form">
        <h1 class="auth-form__title">Reset your password</h1>
        <p class="auth-form__subtitle">Enter your new password below</p>
        
        <%= tag.div(flash[:alert], class: "alert alert--error") if flash[:alert] %>
        <%= tag.div(flash[:notice], class: "alert alert--success") if flash[:notice] %>

        <%= form_with url: password_path(params[:token]), method: :put, class: "auth-form__form" do |form| %>
          <div class="auth-form__field">
            <%= form.label :password, "New password", class: "auth-form__label" %>
            <%= form.password_field :password, required: true, autocomplete: "new-password", placeholder: "Enter new password", maxlength: 72, class: "auth-form__input" %>
          </div>

          <div class="auth-form__field">
            <%= form.label :password_confirmation, "Confirm new password", class: "auth-form__label" %>
            <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", placeholder: "Re-enter new password", maxlength: 72, class: "auth-form__input" %>
          </div>

          <%= form.submit "Reset password", class: "auth-form__submit" %>
        <% end %>

        <div class="auth-form__footer">
          <%= link_to "Back to sign in", new_session_path, class: "auth-form__link" %>
        </div>
      </div>
    </div>

    <div class="auth-page__footer">
      <%= link_to "← Back to home", root_path, class: "auth-page__back" %>
    </div>
  </div>
</div>

