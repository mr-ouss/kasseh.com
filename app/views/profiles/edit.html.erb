<% content_for :title, "Edit Profile · RailsRocket" %>
<% content_for :skip_navigation, true %>
<% content_for :body_class, "" %>

<div class="dashboard dashboard--wide">
  <%= render "shared/dashboard_nav" %>

  <main class="dashboard-main">
    <div class="dashboard-content dashboard-content--wide">
      <%= tag.div(flash[:notice], class: "alert alert--success") if flash[:notice] %>
      <%= tag.div(flash[:alert], class: "alert alert--error") if flash[:alert] %>
      <%= tag.div(flash[:notice], class: "alert alert--success") if flash[:notice] %>
      <%= tag.div(flash[:alert], class: "alert alert--error") if flash[:alert] %>

      <div class="profile-header">
        <h1 class="profile-header__title">Edit Profile</h1>
        <p class="profile-header__subtitle">Update your account information</p>
      </div>

      <!-- Profile Information Form -->
      <div class="profile-card">
        <h2 class="profile-card__title">Personal Information</h2>
        
        <% if @user.oauth_user? %>
          <div class="alert alert--info" style="margin-bottom: 1.5rem;">
            Your profile information is managed by <%= @user.provider.titleize %>. These fields cannot be edited.
          </div>
        <% end %>
        
        <%= form_with model: @user, url: profile_path, method: :patch, class: "profile-form" do |form| %>
          <% if @user.errors.any? && params[:user][:password].blank? %>
            <div class="alert alert--error">
              <ul>
                <% @user.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div class="profile-form__field">
            <%= form.label :first_name, "First Name", class: "profile-form__label" %>
            <%= form.text_field :first_name, placeholder: "Enter your first name", class: "profile-form__input", readonly: @user.oauth_user?, disabled: @user.oauth_user? %>
          </div>

          <div class="profile-form__field">
            <%= form.label :last_name, "Last Name", class: "profile-form__label" %>
            <%= form.text_field :last_name, placeholder: "Enter your last name", class: "profile-form__input", readonly: @user.oauth_user?, disabled: @user.oauth_user? %>
          </div>

          <div class="profile-form__field">
            <%= form.label :email_address, "Email Address", class: "profile-form__label" %>
            <%= form.email_field :email_address, required: true, autocomplete: "username", placeholder: "you@example.com", class: "profile-form__input", readonly: @user.oauth_user?, disabled: @user.oauth_user? %>
          </div>

          <% unless @user.oauth_user? %>
            <div class="profile-form__actions">
              <%= form.submit "Save Changes", class: "button button--primary" %>
              <%= link_to "Cancel", profile_path, class: "button button--ghost" %>
            </div>
          <% end %>
        <% end %>
      </div>

      <!-- Change Password Form -->
      <% unless @user.oauth_user? %>
        <div class="profile-card">
          <h2 class="profile-card__title">Change Password</h2>
          
          <%= form_with model: @user, url: profile_path, method: :patch, class: "profile-form" do |form| %>
          <% if @user.errors.any? && params[:user][:password].present? %>
            <div class="alert alert--error">
              <ul>
                <% @user.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div class="profile-form__field">
            <%= form.label :current_password, "Current Password", class: "profile-form__label" %>
            <%= form.password_field :current_password, autocomplete: "current-password", placeholder: "Enter your current password", class: "profile-form__input" %>
          </div>

          <div class="profile-form__field">
            <%= form.label :password, "New Password", class: "profile-form__label" %>
            <%= form.password_field :password, autocomplete: "new-password", placeholder: "Enter a new password", maxlength: 72, class: "profile-form__input" %>
          </div>

          <div class="profile-form__field">
            <%= form.label :password_confirmation, "Confirm New Password", class: "profile-form__label" %>
            <%= form.password_field :password_confirmation, autocomplete: "new-password", placeholder: "Re-enter your new password", maxlength: 72, class: "profile-form__input" %>
          </div>

          <div class="profile-form__actions">
            <%= form.submit "Update Password", class: "button button--primary" %>
            <%= link_to "Cancel", profile_path, class: "button button--ghost" %>
          </div>
        <% end %>
      </div>
      <% end %>
    </div>
  </main>
</div>
