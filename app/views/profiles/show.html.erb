<% content_for :title, "Profile · Kasseh" %>
<% content_for :skip_navigation, true %>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta content="width=device-width, initial-scale=1" name="viewport">
  <title>Profile · Kasseh</title>
  <link href="/css/normalize.css" rel="stylesheet" type="text/css">
  <link href="/css/base.css" rel="stylesheet" type="text/css">
  <link href="/css/styles.css" rel="stylesheet" type="text/css">
  <link href="/css/landing.css" rel="stylesheet" type="text/css">
  <script src="https://ajax.googleapis.com/ajax/libs/webfont/1.6.26/webfont.js" type="text/javascript"></script>
  <script type="text/javascript">WebFont.load({  google: {    families: ["Instrument Sans:regular,500,600,700"]  }});</script>
  <script type="text/javascript">!function(o,c){var n=c.documentElement,t=" w-mod-";n.className+=t+"js",("ontouchstart"in o||o.DocumentTouch&&c instanceof DocumentTouch)&&(n.className+=t+"touch")}(window,document);</script>
  <style>
    body {
      font-family: 'Instrument Sans', sans-serif;
    }
    .profile-content-wrapper {
      max-width: 1000px;
      margin: 0 auto;
      padding: 100px 20px;
    }
    .profile-header-section {
      margin-bottom: 60px;
    }
    .profile-main-title {
      font-size: 48px;
      font-weight: 700;
      margin-bottom: 16px;
      color: #000;
      font-family: 'Instrument Sans', sans-serif;
    }
    .profile-subtitle {
      font-size: 18px;
      color: #666;
      font-family: 'Instrument Sans', sans-serif;
    }
    .profile-card {
      background: #fff;
      border: 1px solid #e5e5e5;
      border-radius: 12px;
      padding: 40px;
      margin-bottom: 40px;
    }
    .profile-card-title {
      font-size: 28px;
      font-weight: 600;
      margin-bottom: 32px;
      color: #000;
      font-family: 'Instrument Sans', sans-serif;
    }
    .profile-card-description {
      font-size: 16px;
      color: #666;
      margin-bottom: 32px;
      line-height: 1.6;
      font-family: 'Instrument Sans', sans-serif;
    }
    .profile-info-grid {
      display: grid;
      gap: 24px;
      margin-bottom: 32px;
    }
    .profile-info-row {
      display: grid;
      grid-template-columns: 180px 1fr;
      gap: 16px;
      align-items: center;
      padding-bottom: 24px;
      border-bottom: 1px solid #f0f0f0;
    }
    .profile-info-row-last {
      border-bottom: none;
      padding-bottom: 0;
    }
    .profile-info-label {
      font-weight: 600;
      color: #333;
      font-family: 'Instrument Sans', sans-serif;
    }
    .profile-info-value {
      color: #666;
      margin: 0;
      font-family: 'Instrument Sans', sans-serif;
    }
    .profile-card-danger {
      border: 2px solid #ef4444;
    }
    .profile-card-title-danger {
      font-size: 28px;
      font-weight: 600;
      margin-bottom: 16px;
      color: #ef4444;
      font-family: 'Instrument Sans', sans-serif;
    }
    .profile-warning-box {
      background: #fef2f2;
      border: 1px solid #fecaca;
      border-radius: 8px;
      padding: 16px;
      margin-bottom: 24px;
      color: #991b1b;
      font-family: 'Instrument Sans', sans-serif;
    }
    .profile-danger-list {
      color: #666;
      margin-bottom: 32px;
      padding-left: 20px;
      line-height: 1.8;
      font-family: 'Instrument Sans', sans-serif;
    }
    .profile-danger-button {
      background: #ef4444;
      color: white !important;
      border: none;
      padding: 16px 32px;
      border-radius: 8px;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.3s;
      font-family: 'Instrument Sans', sans-serif;
    }
    .profile-danger-button:hover {
      background: #dc2626;
      color: white !important;
    }
    .primary-button .primary-button-text {
      color: white;
    }
    .primary-button .primary-button-text.black {
      color: black;
    }
  </style>
</head>
<body>
  <div class="pages-wrapper">
    <!-- Navigation -->
    <div data-animation="default" data-collapse="medium" data-duration="400" data-easing="ease" data-easing2="ease" role="banner" class="navbar w-nav">
      <div class="container w-container">
        <div class="navbar-wrapper">
          <a href="/" class="brand-logo-wrap w-nav-brand"><img src="/kasseh-logo-black.svg" loading="lazy" alt="Quentin Kasseh" class="brand-logo"></a>
          <nav role="navigation" class="navigation w-nav-menu">
            <div class="nav-link-wrap">
              <a href="/articles" class="nav-link w-inline-block">
                <div class="nav-link-text">Articles</div>
                <div class="nav-link-text">Articles</div>
              </a>
              <a href="/articles/new" class="nav-link w-inline-block">
                <div class="nav-link-text">New Article</div>
                <div class="nav-link-text">New Article</div>
              </a>
            </div>
          </nav>
          <div class="nav-button">
            <a href="/" class="primary-button desktop-on w-inline-block">
              <div class="primary-button-wrap">
                <div class="primary-button-texts">
                  <div class="primary-button-text">Home</div>
                  <div class="primary-button-text black">Home</div>
                </div>
                <div class="primary-button-icons"><img loading="lazy" src="/images/arrow-right-W.svg" alt="Primary Button Icon" class="primary-button-icon"><img loading="lazy" src="/images/arrow-right-B.svg" alt="Primary Button Icon" class="primary-button-icon"></div>
              </div>
            </a>
            <div class="menu-button w-nav-button">
              <div data-is-ix2-target="1" class="hamburger" data-w-id="a9b91f4d-acaa-bffc-d256-c949c3602477" data-animation-type="lottie" data-src="/documents/black.json" data-loop="0" data-direction="1" data-autoplay="0" data-renderer="svg" data-default-duration="0" data-duration="4.083333333333333" data-ix2-initial-state="0"></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Profile Content -->
    <section class="section">
      <div class="w-layout-blockcontainer container w-container">
        <div class="profile-content-wrapper">
          <!-- Profile Header -->
          <div class="profile-header-section">
            <h1 class="profile-main-title">My Profile</h1>
            <p class="profile-subtitle">Manage your account information</p>
          </div>

          <!-- Personal Information Card -->
          <div class="profile-card">
            <h2 class="profile-card-title">Personal Information</h2>
            
            <div class="profile-info-grid">
              <div class="profile-info-row">
                <dt class="profile-info-label">First Name</dt>
                <dd class="profile-info-value"><%= @user.first_name.presence || "Not set" %></dd>
              </div>
              
              <div class="profile-info-row">
                <dt class="profile-info-label">Last Name</dt>
                <dd class="profile-info-value"><%= @user.last_name.presence || "Not set" %></dd>
              </div>
              
              <div class="profile-info-row profile-info-row-last">
                <dt class="profile-info-label">Email</dt>
                <dd class="profile-info-value"><%= @user.email_address %></dd>
              </div>
            </div>

            <%= link_to edit_profile_path, class: "primary-button w-inline-block" do %>
              <div class="primary-button-wrap">
                <div class="primary-button-texts">
                  <div class="primary-button-text">Edit Profile</div>
                  <div class="primary-button-text black">Edit Profile</div>
                </div>
                <div class="primary-button-icons"><img loading="lazy" src="/images/arrow-right-W.svg" alt="Primary Button Icon" class="primary-button-icon"><img loading="lazy" src="/images/arrow-right-B.svg" alt="Primary Button Icon" class="primary-button-icon"></div>
              </div>
            <% end %>
          </div>

          <!-- API Access Card -->
          <div class="profile-card">
            <h2 class="profile-card-title">API Access</h2>
            <p class="profile-card-description">
              Generate API tokens to access your account programmatically.
            </p>
            
            <div class="profile-info-grid">
              <div class="profile-info-row">
                <dt class="profile-info-label">Active Tokens</dt>
                <dd class="profile-info-value"><%= @user.api_tokens.active.count %></dd>
              </div>
              
              <div class="profile-info-row profile-info-row-last">
                <dt class="profile-info-label">Total Tokens</dt>
                <dd class="profile-info-value"><%= @user.api_tokens.count %></dd>
              </div>
            </div>

            <%= link_to api_tokens_path, class: "primary-button w-inline-block" do %>
              <div class="primary-button-wrap">
                <div class="primary-button-texts">
                  <div class="primary-button-text">Manage API Tokens</div>
                  <div class="primary-button-text black">Manage API Tokens</div>
                </div>
                <div class="primary-button-icons"><img loading="lazy" src="/images/arrow-right-W.svg" alt="Primary Button Icon" class="primary-button-icon"><img loading="lazy" src="/images/arrow-right-B.svg" alt="Primary Button Icon" class="primary-button-icon"></div>
              </div>
            <% end %>
          </div>

          <!-- Danger Zone Card -->
          <div class="profile-card profile-card-danger">
            <h2 class="profile-card-title-danger">Delete Account</h2>
            
            <div class="profile-warning-box">
              <strong>⚠️ Warning:</strong> This action is permanent and cannot be undone.
            </div>

            <p class="profile-card-description">
              Deleting your account will permanently remove:
            </p>
            <ul class="profile-danger-list">
              <li>Your profile and account information</li>
              <li>All file transfer history and activity logs</li>
              <li>All authentication sessions</li>
              <li>All OAuth integrations</li>
            </ul>

            <%= button_to "Delete My Account", 
                profile_path, 
                method: :delete, 
                class: "profile-danger-button",
                data: { 
                  turbo_confirm: "Are you absolutely sure? This will permanently delete your account and all associated data. This action cannot be undone.",
                  turbo_method: :delete 
                } %>
          </div>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <section class="section footer">
      <div class="w-layout-blockcontainer container w-container">
        <div class="footer-wrapper">
          <div class="footer-wrap">
            <div class="footer-left-wrap">
              <a href="/" class="footer-logo-wrap w-inline-block"><img src="/kasseh-logo-white.svg" loading="lazy" alt="Quentin Kasseh" class="footer-logo"></a>
              <div class="social-wrap mobile-off">
                <a href="https://twitter.com/quentinkasseh" target="_blank" rel="noopener noreferrer" class="social-link-wrap w-inline-block"><img src="/images/Twitter-W.svg" loading="lazy" alt="X / Twitter" class="social-icon white"><img src="/images/Twitter-B.svg" loading="lazy" alt="X / Twitter" class="social-icon black"></a>
                <a href="https://www.linkedin.com/in/quentink" target="_blank" rel="noopener noreferrer" class="social-link-wrap w-inline-block"><img src="/images/Linkedin-W.svg" loading="lazy" alt="LinkedIn" class="social-icon white"><img src="/images/Linkedin-B.svg" loading="lazy" alt="LinkedIn" class="social-icon black"></a>
              </div>
            </div>
            <div class="footer-rght-wrap">
              <div class="footer-single-wrap">
                <div class="footer-menu-title">Navigation</div>
                <div class="footer-menu-wrap">
                  <a href="/" class="footer-link-wrap w-inline-block">
                    <div class="footer-link-text">Home</div>
                  </a>
                  <a href="/articles" class="footer-link-wrap w-inline-block">
                    <div class="footer-link-text">Articles</div>
                  </a>
                  <a href="/profile" class="footer-link-wrap w-inline-block">
                    <div class="footer-link-text">Profile</div>
                  </a>
                </div>
              </div>
              <div class="footer-single-wrap">
                <div class="footer-menu-title">Company</div>
                <div class="footer-menu-wrap">
                  <a href="https://www.syntaxia.com" target="_blank" rel="noopener noreferrer" class="footer-link-wrap w-inline-block">
                    <div class="footer-link-text">Syntaxia</div>
                  </a>
                  <a href="mailto:quentin@kasseh.com" class="footer-link-wrap w-inline-block">
                    <div class="footer-link-text">Contact</div>
                  </a>
                </div>
              </div>
              <div class="footer-single-wrap">
                <div class="footer-menu-title">Legal</div>
                <div class="footer-menu-wrap">
                  <a href="/privacy" class="footer-link-wrap w-inline-block">
                    <div class="footer-link-text">Privacy</div>
                  </a>
                  <a href="/terms" class="footer-link-wrap w-inline-block">
                    <div class="footer-link-text">Terms</div>
                  </a>
                </div>
              </div>
            </div>
            <div class="mobile-on">
              <div class="social-wrap mobile-on">
                <a href="https://twitter.com/quentinkasseh" target="_blank" rel="noopener noreferrer" class="social-link-wrap w-inline-block"><img src="/images/Twitter-W.svg" loading="lazy" alt="X / Twitter" class="social-icon white"><img src="/images/Twitter-B.svg" loading="lazy" alt="X / Twitter" class="social-icon black"></a>
                <a href="https://www.linkedin.com/in/quentink" target="_blank" rel="noopener noreferrer" class="social-link-wrap w-inline-block"><img src="/images/Linkedin-W.svg" loading="lazy" alt="LinkedIn" class="social-icon white"><img src="/images/Linkedin-B.svg" loading="lazy" alt="LinkedIn" class="social-icon black"></a>
              </div>
            </div>
          </div>
          <div class="footer-copyright-wrap">
            <div class="copyright-left-text">2025 © Quentin O. Kasseh. All rights reserved.</div>
            <div class="copyright-right-text">
              <a href="/privacy" class="site-link">Privacy</a> | <a href="/terms" class="site-link">Terms</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
  
  <script src="https://d3e54v103j8qbb.cloudfront.net/js/jquery-3.5.1.min.dc5e7f18c8.js?site=691f5cd83104988ac6f1ee82" type="text/javascript" integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=" crossorigin="anonymous"></script>
  <script src="/js/main.js" type="text/javascript"></script>
</body>
</html>
