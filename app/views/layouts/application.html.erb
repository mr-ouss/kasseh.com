<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title><%= content_for(:title) || "Quentin Kasseh · Builder, Engineer, Founder" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= content_for(:description) || "Quentin Kasseh is a builder, engineer, and founder focused on creating elegant solutions to complex problems." %>">

    <%# Open Graph / Facebook %>
    <meta property="og:type" content="website">
    <meta property="og:url" content="<%= request.original_url %>">
    <meta property="og:title" content="<%= content_for(:title) || "Quentin Kasseh · Builder, Engineer, Founder" %>">
    <meta property="og:description" content="<%= content_for(:description) || "Quentin Kasseh is a builder, engineer, and founder focused on creating elegant solutions to complex problems." %>">
    <% if content_for?(:og_image) %>
      <meta property="og:image" content="<%= content_for(:og_image) %>">
    <% end %>

    <%# Twitter %>
    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:url" content="<%= request.original_url %>">
    <meta property="twitter:title" content="<%= content_for(:title) || "Quentin Kasseh · Builder, Engineer, Founder" %>">
    <meta property="twitter:description" content="<%= content_for(:description) || "Quentin Kasseh is a builder, engineer, and founder focused on creating elegant solutions to complex problems." %>">
    <% if content_for?(:og_image) %>
      <meta property="twitter:image" content="<%= content_for(:og_image) %>">
    <% end %>

    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Google Analytics %>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-NFCW4B7LWG"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-NFCW4B7LWG');
    </script>

    <%= yield :head %>

    <%# Font Awesome Kit %>
    <script src="https://kit.fontawesome.com/21cd6127b9.js" crossorigin="anonymous"></script>

    <%# Favicon with cache busting %>
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=2">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=2">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=2">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=2">
    <link rel="manifest" href="/site.webmanifest">

    <%# Tailwind CSS %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%# Application styles %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body<%= content_for?(:body_class) ? " class=\"#{yield(:body_class)}\"".html_safe : '' %>>
    <%= render "shared/dashboard_nav" if Current.user && !content_for?(:skip_navigation) %>
    <%= yield %>
  </body>
</html>
