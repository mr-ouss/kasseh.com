<% content_for :title, "Quentin Kasseh · Builder, Engineer, Founder" %>
<% content_for :skip_navigation, true %>
<% content_for :body_class, "landing-aerial" %>

<div id="wrapper" class="opacity-0 animate-fade-in-slow">
  <!-- Animated Background -->
  <div id="bg" class="fixed inset-0 bg-gradient-to-br from-charcoal-900 via-charcoal-800 to-charcoal-900 animate-bg-pan">
    <!-- Animated pattern overlay -->
    <div class="absolute inset-0 opacity-20">
      <div class="absolute inset-0 bg-grid-pattern animate-grid-flow"></div>
    </div>
  </div>

  <!-- Overlay for depth -->
  <div id="overlay" class="fixed inset-0 bg-gradient-radial from-transparent via-charcoal-900/30 to-charcoal-950/60 opacity-0 animate-overlay-fade"></div>

  <!-- Main Content -->
  <div id="main" class="fixed inset-0 flex items-center justify-center text-center z-10">
    <div class="max-w-4xl px-6">

      <!-- Header -->
      <header id="header" class="opacity-0 animate-header-rise">
        <!-- Logo -->
        <div class="mb-8 flex justify-center">
          <%= image_tag "kasseh-logo.png", alt: "Kasseh", class: "w-32 h-32 md:w-40 md:h-40 opacity-90 hover:opacity-100 transition-opacity duration-300", id: "kasseh-logo" %>
        </div>

        <!-- Name -->
        <h1 class="font-serif text-4xl md:text-6xl font-bold text-white mb-4 tracking-tight">
          Quentin O. Kasseh
        </h1>

        <!-- Tagline -->
        <p class="text-lg md:text-xl text-charcoal-200 font-light mb-12 tracking-wide">
          Technology Entrepreneur <span class="text-charcoal-500 mx-2">•</span> Founder <span class="text-charcoal-500 mx-2">•</span> Computer Scientist
        </p>

        <!-- Navigation -->
        <nav class="mb-8">
          <ul class="flex justify-center items-center space-x-6 md:space-x-8">
            <li>
              <a href="https://twitter.com/quentinkasseh" target="_blank" rel="noopener noreferrer"
                 class="text-charcoal-300 hover:text-gold-500 transition-all duration-300 transform hover:scale-110 inline-block"
                 title="X (Twitter)">
                <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
              </a>
            </li>
            <li>
              <a href="https://www.linkedin.com/in/quentink" target="_blank" rel="noopener noreferrer"
                 class="text-charcoal-300 hover:text-gold-500 transition-all duration-300 transform hover:scale-110 inline-block"
                 title="LinkedIn">
                <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
              </a>
            </li>
            <li>
              <a href="mailto:quentin@kasseh.com"
                 class="text-charcoal-300 hover:text-gold-500 transition-all duration-300 transform hover:scale-110 inline-block"
                 title="Email">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </a>
            </li>
            <li>
              <a href="https://www.syntaxia.com" target="_blank" rel="noopener noreferrer"
                 class="text-charcoal-300 hover:text-gold-500 transition-all duration-300 transform hover:scale-110 inline-block"
                 title="Syntaxia">
                <i class="fa-kit fa-syntaxia-icon-logo-light fa-fade fa-2xl"></i>
              </a>
            </li>
          </ul>
        </nav>

        <!-- Secondary Navigation -->
        <div class="mt-12 pt-8 border-t border-charcoal-700/30">
          <nav>
            <ul class="flex justify-center items-center space-x-6 text-sm md:text-base">
              <li>
                <%= link_to "Writing", articles_path, class: "text-charcoal-300 hover:text-white transition-colors duration-300 font-medium" %>
              </li>
              <li class="text-charcoal-600">•</li>
              <li>
                <%= link_to "About", "#about", class: "text-charcoal-300 hover:text-white transition-colors duration-300 font-medium",
                    data: { turbo: false }, onclick: "scrollToAbout(event)" %>
              </li>
              <li class="text-charcoal-600">•</li>
              <li>
                <%= link_to "Contact", "#contact", class: "text-charcoal-300 hover:text-white transition-colors duration-300 font-medium",
                    data: { turbo: false }, onclick: "scrollToContact(event)" %>
              </li>
            </ul>
          </nav>
        </div>
      </header>

    </div>
  </div>

  <!-- Footer -->
  <footer id="footer" class="fixed bottom-0 left-0 right-0 z-10 pb-8 text-center opacity-0 animate-footer-fade">
    <span class="text-charcoal-400 text-sm inline-flex items-center justify-center space-x-2">
      <span>&copy; <%= Time.current.year %></span>
      <%= image_tag "kasseh-logo-small.png", alt: "", class: "w-4 h-4 opacity-60 inline-block mx-1" %>
      <a href="/" class="hover:text-gold-500 transition-colors duration-300">Quentin O. Kasseh</a>
    </span>
  </footer>
</div>

<style>
  /* Custom animations */
  @keyframes fade-in-slow {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes bg-pan {
    0% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
    100% {
      background-position: 0% 50%;
    }
  }

  @keyframes grid-flow {
    0% {
      transform: translateX(0) translateY(0);
    }
    100% {
      transform: translateX(30px) translateY(30px);
    }
  }

  @keyframes overlay-fade {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes header-rise {
    from {
      opacity: 0;
      transform: translate3d(0, 2rem, 0);
    }
    to {
      opacity: 1;
      transform: translate3d(0, 0, 0);
    }
  }

  @keyframes footer-fade {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .animate-fade-in-slow {
    animation: fade-in-slow 3s forwards;
  }

  .animate-bg-pan {
    background-size: 400% 400%;
    animation: bg-pan 30s ease-in-out infinite;
  }

  .bg-grid-pattern {
    background-image:
      linear-gradient(rgba(212, 169, 98, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(212, 169, 98, 0.03) 1px, transparent 1px);
    background-size: 50px 50px;
  }

  .animate-grid-flow {
    animation: grid-flow 60s linear infinite;
  }

  .bg-gradient-radial {
    background: radial-gradient(circle at center, transparent 0%, rgba(26, 26, 31, 0.3) 50%, rgba(10, 10, 12, 0.6) 100%);
  }

  .animate-overlay-fade {
    animation: overlay-fade 2s 1.5s forwards;
  }

  .animate-header-rise {
    animation: header-rise 1.5s 2s forwards;
  }

  .animate-footer-fade {
    animation: footer-fade 1.5s 3s forwards;
  }

  /* Smooth scrolling */
  html {
    scroll-behavior: smooth;
  }

  body.landing-aerial {
    overflow: hidden;
  }
</style>

<script>
  function scrollToAbout(event) {
    event.preventDefault();
    alert('About section coming soon! Check back later.');
  }

  function scrollToContact(event) {
    event.preventDefault();
    window.location.href = 'mailto:quentin@kasseh.com';
  }

  // Prevent page loading class
  window.addEventListener('load', function() {
    document.body.className = document.body.className.replace('loading', '');
  });

  // Prevent touch scrolling on mobile
  window.addEventListener('touchmove', function(e) {
    if (document.body.classList.contains('landing-aerial')) {
      e.preventDefault();
    }
  }, { passive: false });

  window.addEventListener('orientationchange', function() {
    document.body.scrollTop = 0;
  });
</script>
