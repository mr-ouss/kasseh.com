                          <div class="blog-meta-divide">|</div>
                          <div class="blog-item-date"><%= article.published_at&.strftime("%b %d, %Y") %></div>
                        </div>
                        <a href="<%= article_path(article) %>" class="blog-item-title"><%= article.title %></a>
                        <p class="blog-item-details"><%= article.excerpt %></p>
