<% content_for :title, "Quentin O. Kasseh | Technology Leader, Strategist, and Innovator" %>
<% content_for :skip_navigation, true %>
<% content_for :body_class, "landing-aerial" %>

<div id="wrapper">
  <!-- Animated Background -->
  <div id="bg"></div>

  <!-- Overlay with pattern -->
  <div id="overlay"></div>

  <!-- Main Content -->
  <div id="main">
    <div class="content-wrapper">
      <!-- Header -->
      <header id="header">
        <!-- SVG Logo with glow effect -->
        <div class="logo-container" 
             id="logo-container" 
             data-controller="svg-logo"
             data-svg-logo-url-value="/kasseh-logo-white.svg">
          <div class="logo-glow"></div>
          <div data-svg-logo-target="container" class="logo-svg"></div>
        </div>

        <!-- Name -->
        <h1>Quentin O. Kasseh</h1>
        
        <!-- Tagline -->
        <p>Technology Entrepreneur &nbsp;&bull;&nbsp; Founder &nbsp;&bull;&nbsp; Computer Scientist</p>
        
        <!-- Social Navigation -->
        <nav>
          <ul>
            <li>
              <a href="https://twitter.com/quentinkasseh" target="_blank" rel="noopener noreferrer" title="Check my X">
                <svg class="social-icon" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
              </a>
            </li>
            <li>
              <a href="https://www.linkedin.com/in/quentink" target="_blank" rel="noopener noreferrer" title="Check my LinkedIn profile">
                <svg class="social-icon" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
              </a>
            </li>
            <li>
              <a href="mailto:quentin@kasseh.com" title="Send me an e-mail">
                <svg class="social-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </a>
            </li>
            <li>
              <a href="https://www.syntaxia.com" target="_blank" rel="noopener noreferrer" title="Syntaxia">
                <i class="fa-kit fa-syntaxia-icon-logo-light fa-fade fa-2xl social-icon"></i>
              </a>
            </li>
          </ul>
        </nav>
      </header>
    </div>
  </div>
</div>

<style>
  /* ===================================
     WRAPPER & ANIMATIONS (inspired by old site)
     =================================== */
  
  @keyframes wrapper {
    0% { opacity: 0; }
    100% { opacity: 1; }
  }

  @keyframes bg {
    0% {
      transform: translate3d(0,0,0);
    }
    100% {
      transform: translate3d(-2250px,0,0);
    }
  }

  @keyframes overlay {
    0% { opacity: 0; }
    100% { opacity: 1; }
  }

  @keyframes header {
    0% {
      transform: translate3d(0,1em,0);
      opacity: 0;
    }
    100% {
      transform: translate3d(0,0,0);
      opacity: 1;
    }
  }

  @keyframes logo-glow {
    from { opacity: 0; }
    to { opacity: 0.4; }
  }

  /* ===================================
     BASE LAYOUT
     =================================== */

  body.landing-aerial {
    overflow: hidden;
    background: #fff;
  }

  body.loading * {
    animation: none !important;
  }

  #wrapper {
    animation: wrapper 3s forwards;
    height: 100%;
    left: 0;
    opacity: 0;
    position: fixed;
    top: 0;
    width: 100%;
  }

  /* ===================================
     ANIMATED BACKGROUND
     =================================== */

  #bg {
    animation: bg 60s linear infinite;
    backface-visibility: hidden;
    transform: translate3d(0,0,0);
    
    /* Background image from old site */
    background: #348cb2 url(<%= asset_path('bg.jpg') %>) bottom left;
    background-repeat: repeat-x;
    background-size: 2250px auto;
    width: 6750px;
    height: 100%;
    left: 0;
    opacity: 1;
    position: fixed;
    top: 0;
    z-index: 1;
  }

  /* ===================================
     OVERLAY WITH PATTERN
     =================================== */

  #overlay {
    animation: overlay 1.5s 1.5s forwards;
    background-attachment: fixed, fixed;
    background-image: url(<%= asset_path('overlay-pattern.png') %>), url(<%= asset_path('overlay.svg') %>);
    background-position: top left, center center;
    background-repeat: repeat, no-repeat;
    background-size: auto, cover;
    height: 100%;
    left: 0;
    opacity: 0;
    position: fixed;
    top: 0;
    width: 100%;
    z-index: 2;
  }

  /* ===================================
     MAIN CONTENT
     =================================== */

  #main {
    height: 100%;
    left: 0;
    position: fixed;
    text-align: center;
    top: 0;
    width: 100%;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .content-wrapper {
    display: block !important;
    max-width: 100% !important;
    padding: 3em 2em !important;
    position: relative !important;
    text-align: center !important;
    width: 100% !important;
  }

  /* ===================================
     HEADER
     =================================== */

  #header {
    animation: header 1s 2.25s forwards;
    backface-visibility: hidden;
    cursor: default;
    display: inline-block;
    opacity: 0;
    position: relative;
    text-align: center;
    top: -1em;
    vertical-align: middle;
    width: 90%;
  }

  /* Logo container with SVG */
  .logo-container {
    position: relative;
    display: inline-block;
    margin-bottom: 2em;
  }

  .logo-svg {
    width: 8em;
    height: 8em;
    position: relative;
    z-index: 2;
  }

  .logo-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 12em;
    height: 12em;
    background: radial-gradient(circle, rgba(212, 169, 98, 0.4) 0%, transparent 70%);
    filter: blur(40px);
    opacity: 0;
    animation: logo-glow 2s 2.5s forwards;
    z-index: 1;
  }

  /* Name and tagline */
  #header h1 {
    color: #fff !important;
    font-size: 3.25em !important;
    font-weight: 900 !important;
    letter-spacing: -0.035em !important;
    line-height: 1em !important;
    margin: 0 0 0.5em 0 !important;
    font-family: 'Source Sans Pro', 'Inter', sans-serif !important;
  }

  #header p {
    color: rgba(255, 255, 255, 0.75) !important;
    font-size: 1.25em !important;
    font-weight: 300 !important;
    letter-spacing: -0.025em !important;
    line-height: 1.75em !important;
    margin: 0 0 2.5em 0 !important;
    font-family: 'Source Sans Pro', 'Inter', sans-serif !important;
  }

  /* Logo images */
  #kasseh-logo {
    height: 0.65em;
    vertical-align: middle;
    position: relative;
    top: -0.075em;
    margin-right: 0.25em;
    opacity: 0.9;
    transition: all 0.2s ease-in-out;
  }

  #kasseh-logo:hover {
    opacity: 1;
    filter: drop-shadow(0 0 20px rgba(212, 169, 98, 0.8));
  }

  /* ===================================
     NAVIGATION
     =================================== */

  #header nav {
    margin: 0;
  }

  #header nav ul {
    border: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  #header nav li {
    border: 0;
    display: inline-block;
    margin: 0 1em 0 0;
    padding: 0;
  }

  #header nav li:last-child {
    margin-right: 0;
  }

  #header nav a {
    border: 0;
    color: rgba(255, 255, 255, 0.75);
    display: inline-block;
    text-decoration: none;
    transition: color 0.2s ease-in-out, border-color 0.2s ease-in-out;
  }

  #header nav a:hover {
    color: #d4a962;
  }

  .social-icon {
    width: 2em;
    height: 2em;
    transition: all 0.3s ease-in-out;
  }

  #header nav a:hover .social-icon {
    filter: drop-shadow(0 0 12px rgba(212, 169, 98, 0.7));
    transform: translateY(-3px) scale(1.1);
  }

  /* ===================================
     FOOTER
     =================================== */

  #footer {
    backface-visibility: hidden;
    bottom: 3em;
    cursor: default;
    height: 3em;
    left: 3em;
    line-height: 3em;
    position: fixed;
    text-align: left;
    width: calc(100% - 6em);
    z-index: 10000;
  }

  .copyright {
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.8em;
    letter-spacing: 0.075em;
    list-style: none;
    padding: 0;
    text-transform: uppercase;
  }

  .copyright a {
    border: 0;
    color: rgba(255, 255, 255, 0.5);
    text-decoration: none;
    transition: color 0.2s ease-in-out;
  }

  .copyright a:hover {
    color: #d4a962;
  }

  #kasseh-logo-footer {
    height: 0.9em;
    opacity: 0.6;
    vertical-align: middle;
    position: relative;
    top: -0.075em;
    margin: 0 0.25em;
  }

  /* ===================================
     RESPONSIVE
     =================================== */

  @media screen and (max-width: 1680px) {
    #header h1 {
      font-size: 2.75em;
    }
  }

  @media screen and (max-width: 736px) {
    #header h1 {
      font-size: 2em;
    }

    #header p {
      font-size: 1em;
    }

    .logo-svg {
      width: 6em;
      height: 6em;
    }

    #footer {
      bottom: 1.5em;
      left: 1.5em;
      width: calc(100% - 3em);
    }
  }

  @media screen and (max-width: 480px) {
    #header nav li {
      margin: 0 0.5em 0 0;
    }

    .social-icon {
      width: 1.5em;
      height: 1.5em;
    }
  }
</style>

<script>
  /* ===================================
     MAGNETIC LOGO EFFECT WITH SVG
     =================================== */
  
  function initMagneticLogo() {
    const logoContainer = document.querySelector('.logo-svg');
    const svgLogo = logoContainer ? logoContainer.querySelector('svg') : null;
    
    if (!logoContainer || !svgLogo) return;
    
    logoContainer.addEventListener('mousemove', (e) => {
      const rect = logoContainer.getBoundingClientRect();
      const centerX = rect.left + rect.width / 2;
      const centerY = rect.top + rect.height / 2;
      
      // Calculate mouse position relative to center
      const relativeX = (e.clientX - centerX) / (rect.width / 2);
      const relativeY = (e.clientY - centerY) / (rect.height / 2);
      
      // Magnetic pull and rotation
      const deltaX = relativeX * 12;
      const deltaY = relativeY * 12;
      const rotateY = relativeX * 15;
      const rotateX = -relativeY * 15;
      
      svgLogo.style.transform = `
        translate(${deltaX}px, ${deltaY}px) 
        rotateX(${rotateX}deg) 
        rotateY(${rotateY}deg) 
        scale(1.08)
      `;
      svgLogo.style.transition = 'transform 0.1s ease-out';
    });
    
    logoContainer.addEventListener('mouseleave', () => {
      if (svgLogo) {
        svgLogo.style.transform = 'translate(0, 0) rotateX(0deg) rotateY(0deg) scale(1)';
        svgLogo.style.transition = 'transform 0.3s ease-out';
      }
    });
  }

  /* ===================================
     INITIALIZATION
     =================================== */
  
  document.addEventListener('DOMContentLoaded', function() {
    // Initialize magnetic logo effect
    // Wait a bit for the SVG to load via Stimulus controller
    setTimeout(() => {
      initMagneticLogo();
    }, 500);
  });

  // Remove loading class (copied from old site)
  window.onload = function() { 
    document.body.className = document.body.className.replace('loading', '').trim();
  }

  // Prevent touch scrolling on mobile for this page
  window.addEventListener('touchmove', function(e) {
    if (document.body.classList.contains('landing-aerial')) {
      e.preventDefault();
    }
  }, { passive: false });

  // Handle orientation changes
  window.addEventListener('orientationchange', function() {
    document.body.scrollTop = 0;
  });
</script>
