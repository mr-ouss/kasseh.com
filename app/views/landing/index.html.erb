                          <%= image_tag article.featured_image, loading: "lazy", alt: article.title, class: "blog-item-image" %>
                        <% else %>
                          <img src="https://placehold.co/600x400/1a1a1f/d4a962?text=<%= URI.encode_www_form_component(article.title) %>" loading="lazy" alt="<%= article.title %>" class="blog-item-image">
                        <% end %>
                        <div class="image-overly"></div>
                      </a>
