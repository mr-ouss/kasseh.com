  <style>
    @media (max-width:991px) and (min-width:768px) {html.w-mod-js:not(.w-mod-ix) [data-w-id="4b124b77-5ac6-e8c2-9bb1-169a9ff79b2d"] {opacity:0;}}
    @media (max-width:767px) and (min-width:480px) {html.w-mod-js:not(.w-mod-ix) [data-w-id="4b124b77-5ac6-e8c2-9bb1-169a9ff79b2d"] {opacity:0;}}
    @media (max-width:479px) {html.w-mod-js:not(.w-mod-ix) [data-w-id="4b124b77-5ac6-e8c2-9bb1-169a9ff79b2d"] {opacity:0;}}
    
    /* Animated background from old-site */
    @keyframes bg {
      0% {
        transform: translate3d(0,0,0);
      }
      100% {
        transform: translate3d(-2250px,0,0);
      }
    }
    
    .hero-wrapper {
      position: relative;
      overflow: hidden;
      background-image: none !important;
      background-color: #348cb2 !important;
      margin-top: 20px;
      margin-bottom: 5px;
    }
    
    .hero-wrapper::before {
      content: '';
      animation: bg 60s linear infinite;
      backface-visibility: hidden;
      transform: translate3d(0,0,0);
      background: #348cb2 url('/images/bg.jpg') bottom left;
      background-repeat: repeat-x;
      background-size: auto 100%;
      background-position: bottom left;
      height: 100%;
      left: 0;
      opacity: 1;
      position: absolute;
      top: 30%;
      width: 300%;
      z-index: 1;
    }
    
    .hero-wrapper::after {
      content: '';
      background: url('/images/overlay-pattern.png'), linear-gradient(0deg, rgba(0,0,0,0.15), rgba(0,0,0,0.15));
      height: 100%;
      left: 0;
      position: absolute;
      top: 0;
      width: 100%;
      z-index: 2;
    }
    
    .hero-wrapper .hero-wrap {
      position: relative;
      z-index: 3;
    }
    
    /* Fix hero author image size - match card height */
    .hero-author-wrapper {
      align-items: stretch !important;
    }
    .hero-author-image-wrap {
      width: auto;
      min-width: 120px;
      overflow: hidden;
      border-radius: 12px;
      flex-shrink: 0;
      display: flex;
    }
    .hero-author-image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
    }
    .hero-author-wrap {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }
    
    /* Badge style for hero top details */
    .hero-top-details {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      margin-top: 16px;
      align-items: center;
      justify-content: flex-end;
    }
    .hero-top-content {
      text-align: right !important;
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
    }
    .hero-top-title {
      text-align: right;
    }
    .hero-top-wrap {
      justify-content: flex-end !important;
      align-items: flex-start !important;
    }
    .hero-top-details::before,
    .hero-top-details::after {
      content: none !important;
    }
    
    /* Logo sizing */
    .hero-logo-wrap .hero-logo {
      max-width: 120px;
      height: auto;
    }
    .hero-logo-wrap {
      display: none !important;
    }
    .brand-logo {
      max-width: 60px !important;
      width: 60px !important;
      height: auto !important;
      display: block !important;
    }
    .footer-logo {
      max-width: 60px !important;
      height: auto !important;
    }
    .footer-logo-wrap {
      display: inline-block;
      margin-bottom: 16px;
    }
    
    /* Fixed footer at bottom */
    body {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    .pages-wrapper {
      flex: 1;
      display: flex;
      flex-direction: column;
    }
    .section.hero {
      flex: 1;
    }
    .section.footer {
      margin-top: auto;
    }
  </style>
