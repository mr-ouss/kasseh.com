  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const contentArea = document.getElementById('article_content');
      const excerptArea = document.querySelector('textarea[name="article[excerpt]"]');
      
      // Word count and reading time
      if (contentArea) {
        contentArea.addEventListener('input', function() {
          updateStats();
        });
        updateStats();
      }
      
      // Excerpt character count
      if (excerptArea) {
        excerptArea.addEventListener('input', function() {
          document.getElementById('excerpt-count').textContent = this.value.length;
        });
        document.getElementById('excerpt-count').textContent = excerptArea.value.length;
      }
      
      function updateStats() {
        const text = contentArea.value;
        const words = text.trim().split(/\s+/).filter(word => word.length > 0).length;
        const chars = text.length;
        const readTime = Math.ceil(words / 200) || 1;
        
        document.getElementById('word-count').textContent = words + ' words';
        document.getElementById('char-count').textContent = chars + ' characters';
        document.getElementById('read-time').textContent = readTime + ' min read';
      }
    });
    
    function formatText(command) {
      const textarea = document.getElementById('article_content');
      const start = textarea.selectionStart;
      const end = textarea.selectionEnd;
      const selectedText = textarea.value.substring(start, end);
      
      if (selectedText) {
        let formattedText = selectedText;
        switch(command) {
          case 'bold':
            formattedText = '**' + selectedText + '**';
            break;
          case 'italic':
            formattedText = '_' + selectedText + '_';
            break;
          case 'underline':
            formattedText = '__' + selectedText + '__';
            break;
        }
        
        textarea.value = textarea.value.substring(0, start) + formattedText + textarea.value.substring(end);
        textarea.focus();
        textarea.setSelectionRange(start, start + formattedText.length);
        textarea.dispatchEvent(new Event('input'));
      }
    }
    
    function insertHeading() {
      insertAtCursor('\n\n## Heading\n\n');
    }
    
    function insertList(type) {
      const prefix = type === 'ul' ? '- ' : '1. ';
      insertAtCursor('\n\n' + prefix + 'List item\n' + prefix + 'List item\n' + prefix + 'List item\n\n');
    }
    
    function insertLink() {
      const url = prompt('Enter URL:');
      if (url) {
        const text = prompt('Enter link text:', 'Link text');
        insertAtCursor('[' + (text || 'Link text') + '](' + url + ')');
      }
    }
    
    function insertImage() {
      const url = prompt('Enter image URL:');
      if (url) {
        const alt = prompt('Enter image description (alt text):', 'Image description');
        insertAtCursor('\n\n![' + (alt || 'Image') + '](' + url + ')\n\n');
      }
    }
    
    function insertCode() {
      insertAtCursor('\n\n```\nYour code here\n```\n\n');
    }
    
    function insertQuote() {
      insertAtCursor('\n\n> Your quote here\n\n');
    }
    
    function insertAtCursor(text) {
      const textarea = document.getElementById('article_content');
      const start = textarea.selectionStart;
      const end = textarea.selectionEnd;
      
      textarea.value = textarea.value.substring(0, start) + text + textarea.value.substring(end);
      textarea.focus();
      textarea.setSelectionRange(start + text.length, start + text.length);
      textarea.dispatchEvent(new Event('input'));
    }
    
    function previewImage(event) {
      const file = event.target.files[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = function(e) {
          const preview = document.getElementById('image-preview');
          const placeholder = document.getElementById('image-placeholder');
          
          preview.src = e.target.result;
          preview.style.display = 'block';
          if (placeholder) {
            placeholder.style.display = 'none';
          }
        }
        reader.readAsDataURL(file);
      }
    }
  </script>
