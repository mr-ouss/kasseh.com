<% content_for :title, "#{@article.title} · Quentin Kasseh" %>
<% content_for :description, @article.meta_description || @article.excerpt %>

<!-- Article Page -->
<article class="min-h-screen bg-charcoal-50">
  <!-- Article Header -->
  <header class="bg-white border-b border-charcoal-200">
    <div class="container-custom py-20">
      <div class="max-w-3xl mx-auto">
        <div class="mb-6 flex items-center justify-between">
          <div>
            <span class="text-sm text-gold-600 font-medium"><%= @article.formatted_date %></span>
            <span class="text-sm text-charcoal-400 mx-2">·</span>
            <span class="text-sm text-charcoal-600"><%= @article.reading_time %> min read</span>
            <% if @article.author.present? %>
              <span class="text-sm text-charcoal-400 mx-2">·</span>
              <span class="text-sm text-charcoal-600">By <%= @article.author %></span>
            <% end %>
            <% unless @article.published? %>
              <span class="ml-2 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-300 text-gray-800">
                Draft
              </span>
            <% end %>
          </div>
          
          <% if authenticated? %>
            <div class="flex gap-4">
              <%= link_to edit_article_path(@article), class: "inline-flex items-center text-sm text-gold-600 hover:text-gold-500 font-medium transition-colors" do %>
                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                </svg>
                Edit
              <% end %>
              <%= button_to article_path(@article), method: :delete, data: { turbo_confirm: "Are you sure you want to delete this article?" }, class: "inline-flex items-center text-sm text-red-600 hover:text-red-500 font-medium transition-colors" do %>
                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                </svg>
                Delete
              <% end %>
            </div>
          <% end %>
        </div>

        <h1 class="text-h1 font-serif font-bold text-charcoal-900 mb-6 text-balance">
          <%= @article.title %>
        </h1>

        <% if @article.excerpt.present? %>
          <p class="text-h4 text-charcoal-600 font-light leading-relaxed">
            <%= @article.excerpt %>
          </p>
        <% end %>
      </div>
    </div>
  </header>

  <!-- Article Content -->
  <div class="section-padding bg-white">
    <div class="container-custom">
      <div class="max-w-prose mx-auto">
        <div class="prose prose-lg prose-charcoal max-w-none">
          <%= simple_format(@article.content, class: "text-body-lg text-charcoal-700 leading-relaxed mb-6") %>
        </div>
      </div>
    </div>
  </div>

  <!-- Article Footer / Back Navigation -->
  <div class="bg-charcoal-50 border-t border-charcoal-200 py-12">
    <div class="container-custom">
      <div class="max-w-3xl mx-auto">
        <%= link_to articles_path, class: "inline-flex items-center text-charcoal-700 hover:text-gold-600 transition-colors font-medium" do %>
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
          </svg>
          Back to All Articles
        <% end %>
      </div>
    </div>
  </div>
</article>

<!-- Structured Data for SEO -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "<%= @article.title %>",
  "description": "<%= @article.excerpt %>",
  "author": {
    "@type": "Person",
    "name": "<%= @article.author.presence || 'Quentin Kasseh' %>"
  },
  "datePublished": "<%= (@article.published_at || @article.created_at).iso8601 %>",
  "dateModified": "<%= @article.updated_at.iso8601 %>"
}
</script>
