<% content_for :title, "#{@article.title} · Quentin Kasseh" %>
<% content_for :description, @article.meta_description || @article.excerpt %>

<!-- Article Page -->
<article class="min-h-screen bg-charcoal-50">
  <!-- Article Header -->
  <header class="bg-white border-b border-charcoal-200">
    <div class="container-custom py-20">
      <div class="max-w-3xl mx-auto">
        <div class="mb-6">
          <span class="text-sm text-gold-600 font-medium"><%= @article.formatted_date %></span>
          <span class="text-sm text-charcoal-400 mx-2">·</span>
          <span class="text-sm text-charcoal-600"><%= @article.reading_time %> min read</span>
          <% if @article.author.present? %>
            <span class="text-sm text-charcoal-400 mx-2">·</span>
            <span class="text-sm text-charcoal-600">By <%= @article.author %></span>
          <% end %>
        </div>

        <h1 class="text-h1 font-serif font-bold text-charcoal-900 mb-6 text-balance">
          <%= @article.title %>
        </h1>

        <% if @article.excerpt.present? %>
          <p class="text-h4 text-charcoal-600 font-light leading-relaxed">
            <%= @article.excerpt %>
          </p>
        <% end %>
      </div>
    </div>
  </header>

  <!-- Article Content -->
  <div class="section-padding bg-white">
    <div class="container-custom">
      <div class="max-w-prose mx-auto">
        <div class="prose prose-lg prose-charcoal max-w-none">
          <%= simple_format(@article.content, class: "text-body-lg text-charcoal-700 leading-relaxed mb-6") %>
        </div>
      </div>
    </div>
  </div>

  <!-- Article Footer / Back Navigation -->
  <div class="bg-charcoal-50 border-t border-charcoal-200 py-12">
    <div class="container-custom">
      <div class="max-w-3xl mx-auto">
        <%= link_to articles_path, class: "inline-flex items-center text-charcoal-700 hover:text-gold-600 transition-colors font-medium" do %>
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
          </svg>
          Back to All Articles
        <% end %>
      </div>
    </div>
  </div>
</article>

<!-- Structured Data for SEO -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "<%= @article.title %>",
  "description": "<%= @article.excerpt %>",
  "author": {
    "@type": "Person",
    "name": "<%= @article.author.presence || 'Quentin Kasseh' %>"
  },
  "datePublished": "<%= @article.published_at.iso8601 %>",
  "dateModified": "<%= @article.updated_at.iso8601 %>"
}
</script>
