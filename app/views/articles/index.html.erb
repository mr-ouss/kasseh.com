<% content_for :title, "Writing · Quentin Kasseh" %>
<% content_for :description, "Essays, thoughts, and reflections on building, technology, and craft." %>

<!-- Writing Index Page -->
<div class="min-h-screen bg-charcoal-50">
  <!-- Header -->
  <div class="bg-white border-b border-charcoal-200">
    <div class="container-custom py-20">
      <div class="flex items-start justify-between">
        <div>
          <h1 class="text-h1 font-serif font-bold text-charcoal-900 mb-4">Writing</h1>
          <p class="text-body-lg text-charcoal-600 max-w-2xl">
            Essays, thoughts, and reflections on building, technology, and craft.
          </p>
        </div>
        <% if authenticated? %>
          <%= link_to new_article_path, class: "inline-flex items-center px-6 py-3 bg-gold-600 text-white font-medium rounded-lg hover:bg-gold-500 transition-colors" do %>
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            New Article
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Featured Articles -->
  <% if @featured_articles.any? %>
    <section class="bg-white border-b border-charcoal-200">
      <div class="container-custom py-16">
        <h2 class="text-h3 font-serif font-semibold text-charcoal-900 mb-8">Featured</h2>
        <div class="grid md:grid-cols-3 gap-8">
          <% @featured_articles.each do |article| %>
            <%= link_to article_path(article), class: "group card p-6 block" do %>
              <div class="mb-4">
                <span class="text-sm text-gold-600 font-medium"><%= article.formatted_date %></span>
                <span class="text-sm text-charcoal-400 mx-2">·</span>
                <span class="text-sm text-charcoal-600"><%= article.reading_time %> min read</span>
              </div>
              <h3 class="text-h4 font-serif font-semibold text-charcoal-900 mb-3 group-hover:text-gold-600 transition-colors">
                <%= article.title %>
              </h3>
              <p class="text-body text-charcoal-600 line-clamp-3">
                <%= article.excerpt %>
              </p>
            <% end %>
          <% end %>
        </div>
      </div>
    </section>
  <% end %>

  <!-- All Articles -->
  <section class="section-padding">
    <div class="container-custom">
      <div class="max-w-3xl mx-auto">
        <% if @articles.any? %>
          <div class="space-y-12">
            <% @articles.each do |article| %>
              <article class="border-b border-charcoal-200 pb-12 last:border-b-0">
                <%= link_to article_path(article), class: "group block" do %>
                  <div class="mb-3 flex items-center justify-between">
                    <div>
                      <span class="text-sm text-gold-600 font-medium"><%= article.formatted_date %></span>
                      <span class="text-sm text-charcoal-400 mx-2">·</span>
                      <span class="text-sm text-charcoal-600"><%= article.reading_time %> min read</span>
                      <% unless article.published? %>
                        <span class="ml-2 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-300 text-gray-800">
                          Draft
                        </span>
                      <% end %>
                    </div>
                  </div>
                  <h2 class="text-h2 font-serif font-bold text-charcoal-900 mb-4 group-hover:text-gold-600 transition-colors">
                    <%= article.title %>
                  </h2>
                  <p class="text-body-lg text-charcoal-600 leading-relaxed">
                    <%= article.excerpt %>
                  </p>
                <% end %>
                
                <% if authenticated? %>
                  <div class="mt-4 flex gap-4">
                    <%= link_to edit_article_path(article), class: "inline-flex items-center text-sm text-gold-600 hover:text-gold-500 font-medium transition-colors" do %>
                      <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                      </svg>
                      Edit
                    <% end %>
                    <%= button_to article_path(article), method: :delete, data: { turbo_confirm: "Are you sure you want to delete this article?" }, class: "inline-flex items-center text-sm text-red-600 hover:text-red-500 font-medium transition-colors" do %>
                      <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                      </svg>
                      Delete
                    <% end %>
                  </div>
                <% end %>
              </article>
            <% end %>
          </div>
        <% else %>
          <div class="text-center py-20">
            <p class="text-body-lg text-charcoal-600">No articles published yet. Check back soon!</p>
          </div>
        <% end %>
      </div>
    </div>
  </section>
</div>

<!-- Back to Home Link -->
<div class="bg-white border-t border-charcoal-200 py-8">
  <div class="container-custom">
    <%= link_to root_path, class: "inline-flex items-center text-charcoal-700 hover:text-gold-600 transition-colors font-medium" do %>
      <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
      </svg>
      Back to Home
    <% end %>
  </div>
</div>
