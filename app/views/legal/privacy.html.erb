<% content_for :title, "Privacy Policy · Kasseh" %>
<% content_for :skip_navigation, true %>
<% content_for :body_class, "auth-page-body" %>

<div class="min-h-screen bg-gradient-to-br from-charcoal-900 via-charcoal-800 to-charcoal-900 px-4 py-12">
  <div class="max-w-4xl mx-auto">
    <!-- Logo -->
    <div class="text-center mb-12">
      <%= link_to root_path, class: "inline-block" do %>
        <%= image_tag "kasseh-logo.png", alt: "Kasseh", class: "w-16 h-16 mx-auto opacity-90 hover:opacity-100 transition-opacity duration-300 mb-4" %>
        <h2 class="text-xl font-sans font-bold text-white tracking-wide">KASSEH</h2>
      <% end %>
    </div>

    <!-- Content Card -->
    <div class="bg-white/10 backdrop-blur-md border border-charcoal-700/50 rounded-lg shadow-2xl p-8 md:p-12 mb-8">
      <div class="mb-8 text-center">
        <h1 class="text-3xl md:text-4xl font-sans font-bold text-white mb-3">Privacy Policy</h1>
        <p class="text-charcoal-300 text-sm">Last updated: <%= Time.current.strftime("%B %d, %Y") %></p>
      </div>

      <div class="prose prose-invert max-w-none">
        <section class="mb-8">
          <h2 class="text-2xl font-sans font-bold text-white mb-4">1. Introduction</h2>
          <p class="text-charcoal-200 leading-relaxed">Welcome to kasseh.com ("we," "our," or "us"). This Privacy Policy explains how we collect, use, and protect your personal information when you visit and use our website.</p>
        </section>

        <section class="mb-8">
          <h2 class="text-2xl font-sans font-bold text-white mb-4">2. Information We Collect</h2>

          <h3 class="text-xl font-sans font-semibold text-white mb-3 mt-6">2.1 Account Information</h3>
          <p class="text-charcoal-200 leading-relaxed mb-3">When you create an account, we collect:</p>
          <ul class="list-disc list-inside text-charcoal-200 space-y-2 ml-4">
            <li>Email address</li>
            <li>Name (first and last)</li>
            <li>Password (encrypted and never stored in plain text)</li>
          </ul>

          <h3 class="text-xl font-sans font-semibold text-white mb-3 mt-6">2.2 OAuth Information</h3>
          <p class="text-charcoal-200 leading-relaxed mb-3">If you sign in via Google or Apple, we receive:</p>
          <ul class="list-disc list-inside text-charcoal-200 space-y-2 ml-4">
            <li>Email address</li>
            <li>Name</li>
            <li>Profile picture URL</li>
            <li>OAuth provider ID</li>
          </ul>

          <h3 class="text-xl font-sans font-semibold text-white mb-3 mt-6">2.3 Usage Data</h3>
          <p class="text-charcoal-200 leading-relaxed mb-3">We automatically collect:</p>
          <ul class="list-disc list-inside text-charcoal-200 space-y-2 ml-4">
            <li>Session information and login times</li>
            <li>Pages visited and features used</li>
            <li>Browser type and device information</li>
            <li>IP address and approximate location</li>
          </ul>
        </section>

        <section class="mb-8">
          <h2 class="text-2xl font-sans font-bold text-white mb-4">3. How We Use Your Information</h2>
          <p class="text-charcoal-200 leading-relaxed mb-3">We use your information to:</p>
          <ul class="list-disc list-inside text-charcoal-200 space-y-2 ml-4">
            <li>Provide and maintain access to the website</li>
            <li>Authenticate your account</li>
            <li>Send important service-related notifications</li>
            <li>Improve the website and user experience</li>
            <li>Analyze usage patterns and trends</li>
            <li>Comply with legal obligations</li>
          </ul>
        </section>

        <section class="mb-8">
          <h2 class="text-2xl font-sans font-bold text-white mb-4">4. Data Security</h2>
          <p class="text-charcoal-200 leading-relaxed mb-3">We implement appropriate security measures including:</p>
          <ul class="list-disc list-inside text-charcoal-200 space-y-2 ml-4">
            <li>Encryption of data in transit (HTTPS/TLS)</li>
            <li>Secure password hashing (bcrypt)</li>
            <li>Session management and authentication tokens</li>
            <li>Regular security updates and monitoring</li>
            <li>Restricted database access</li>
          </ul>
          <p class="text-charcoal-200 leading-relaxed mt-3">While we strive to protect your data, no method of transmission over the internet is 100% secure.</p>
        </section>

        <section class="mb-8">
          <h2 class="text-2xl font-sans font-bold text-white mb-4">5. Data Retention</h2>
          <p class="text-charcoal-200 leading-relaxed mb-3">We retain your data as follows:</p>
          <ul class="list-disc list-inside text-charcoal-200 space-y-2 ml-4">
            <li>Account information: Until you delete your account</li>
            <li>Session data: 90 days</li>
            <li>Analytics data: Aggregated and anonymized</li>
          </ul>
        </section>

        <section class="mb-8">
          <h2 class="text-2xl font-sans font-bold text-white mb-4">6. Your Rights</h2>
          <p class="text-charcoal-200 leading-relaxed mb-3">You have the right to:</p>
          <ul class="list-disc list-inside text-charcoal-200 space-y-2 ml-4">
            <li>Access your personal data</li>
            <li>Correct inaccurate data from your profile settings</li>
            <li>Delete your account and associated data</li>
            <li>Export your data</li>
            <li>Withdraw consent for data processing</li>
          </ul>
          <p class="text-charcoal-200 leading-relaxed mt-3">To exercise these rights, contact us at <a href="mailto:privacy@kasseh.com" class="text-gold-500 hover:text-gold-400 transition-colors underline">privacy@kasseh.com</a> or manage your settings from your account dashboard.</p>
        </section>

        <section class="mb-8">
          <h2 class="text-2xl font-sans font-bold text-white mb-4">7. Third-Party Services</h2>
          <p class="text-charcoal-200 leading-relaxed mb-3">We use the following third-party services:</p>
          <ul class="list-disc list-inside text-charcoal-200 space-y-2 ml-4">
            <li><strong class="text-white">Google OAuth:</strong> Authentication service (subject to <a href="https://policies.google.com/privacy" target="_blank" rel="noopener" class="text-gold-500 hover:text-gold-400 transition-colors underline">Google's Privacy Policy</a>)</li>
            <li><strong class="text-white">Apple Sign In:</strong> Authentication service (subject to <a href="https://www.apple.com/legal/privacy/" target="_blank" rel="noopener" class="text-gold-500 hover:text-gold-400 transition-colors underline">Apple's Privacy Policy</a>)</li>
            <li><strong class="text-white">Google Analytics:</strong> Website analytics (anonymized data collection)</li>
          </ul>
          <p class="text-charcoal-200 leading-relaxed mt-3">Each service has its own privacy policy governing their data practices.</p>
        </section>

        <section class="mb-8">
          <h2 class="text-2xl font-sans font-bold text-white mb-4">8. Cookies and Tracking</h2>
          <p class="text-charcoal-200 leading-relaxed mb-3">We use cookies for:</p>
          <ul class="list-disc list-inside text-charcoal-200 space-y-2 ml-4">
            <li>Session management and authentication</li>
            <li>Security and CSRF protection</li>
            <li>Analytics and usage statistics (via Google Analytics)</li>
          </ul>
          <p class="text-charcoal-200 leading-relaxed mt-3">You can control cookies through your browser settings, but this may limit functionality.</p>
        </section>

        <section class="mb-8">
          <h2 class="text-2xl font-sans font-bold text-white mb-4">9. Data Sharing</h2>
          <p class="text-charcoal-200 leading-relaxed mb-3">We do not sell or rent your personal information. We may share data:</p>
          <ul class="list-disc list-inside text-charcoal-200 space-y-2 ml-4">
            <li>With your explicit consent</li>
            <li>To comply with legal obligations</li>
            <li>To protect our rights or the safety of others</li>
            <li>With service providers who assist in operating the website (under strict confidentiality)</li>
          </ul>
        </section>

        <section class="mb-8">
          <h2 class="text-2xl font-sans font-bold text-white mb-4">10. Children's Privacy</h2>
          <p class="text-charcoal-200 leading-relaxed">This website is not intended for children under 13. We do not knowingly collect personal information from children. If you believe a child has provided us with personal data, please contact us.</p>
        </section>

        <section class="mb-8">
          <h2 class="text-2xl font-sans font-bold text-white mb-4">11. International Data Transfers</h2>
          <p class="text-charcoal-200 leading-relaxed">Your information may be transferred to and stored on servers located outside your country of residence. By using the website, you consent to such transfers.</p>
        </section>

        <section class="mb-8">
          <h2 class="text-2xl font-sans font-bold text-white mb-4">12. Changes to This Policy</h2>
          <p class="text-charcoal-200 leading-relaxed">We may update this Privacy Policy periodically. Material changes will be communicated via email or through a notice on the website. Your continued use after changes constitutes acceptance.</p>
        </section>

        <section class="mb-8">
          <h2 class="text-2xl font-sans font-bold text-white mb-4">13. Contact Us</h2>
          <p class="text-charcoal-200 leading-relaxed mb-3">For questions about this Privacy Policy or our data practices:</p>
          <ul class="list-none text-charcoal-200 space-y-2">
            <li><strong class="text-white">Email:</strong> <a href="mailto:privacy@kasseh.com" class="text-gold-500 hover:text-gold-400 transition-colors underline">privacy@kasseh.com</a></li>
            <li><strong class="text-white">General inquiries:</strong> <a href="mailto:support@kasseh.com" class="text-gold-500 hover:text-gold-400 transition-colors underline">support@kasseh.com</a></li>
            <li><strong class="text-white">Website:</strong> <a href="https://kasseh.com" class="text-gold-500 hover:text-gold-400 transition-colors underline">https://kasseh.com</a></li>
          </ul>
        </section>
      </div>
    </div>

    <!-- Back to home link -->
    <div class="text-center mb-8">
      <%= link_to root_path, class: "inline-flex items-center text-charcoal-400 hover:text-white transition-colors duration-300" do %>
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        Back to home
      <% end %>
    </div>

    <!-- Footer -->
    <footer class="text-center text-charcoal-400 text-sm space-y-2 pb-8">
      <div class="inline-flex items-center justify-center space-x-2">
        <span>&copy; <%= Time.current.year %></span>
        <%= image_tag "kasseh-logo-small.png", alt: "", class: "w-4 h-4 opacity-60 inline-block mx-1" %>
        <span>Kasseh</span>
      </div>
      <div class="flex items-center justify-center space-x-4">
        <%= link_to "Privacy", privacy_path, class: "hover:text-gold-500 transition-colors duration-300" %>
        <span class="text-charcoal-600">·</span>
        <%= link_to "Terms", terms_path, class: "hover:text-gold-500 transition-colors duration-300" %>
      </div>
    </footer>
  </div>
</div>
