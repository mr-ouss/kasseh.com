<% content_for :title, "Terms of Service · Kasseh" %>
<% content_for :skip_navigation, true %>
<% content_for :body_class, "auth-page-body" %>

<div class="min-h-screen relative overflow-hidden">
  <div class="fixed inset-0">
    <div class="absolute inset-0 bg-gradient-to-br from-charcoal-950 via-charcoal-900 to-charcoal-950"></div>
    <div class="absolute inset-0 opacity-30">
      <div class="gradient-orb gradient-orb-1"></div>
      <div class="gradient-orb gradient-orb-2"></div>
      <div class="gradient-orb gradient-orb-3"></div>
    </div>
    <canvas id="particles" class="absolute inset-0"></canvas>
  </div>
  <div id="spotlight" class="fixed inset-0 pointer-events-none opacity-0 transition-opacity duration-1000"></div>
  <div class="fixed inset-0 bg-gradient-radial-custom opacity-60 pointer-events-none"></div>
  <div class="relative z-10 min-h-screen px-4 py-12">
  <div class="max-w-4xl mx-auto">
    <!-- Logo -->
    <div class="text-center mb-12">
      <%= link_to root_path, class: "inline-block" do %>
        <%= image_tag "kasseh-logo.png", alt: "Kasseh", class: "w-16 h-16 mx-auto opacity-90 hover:opacity-100 transition-opacity duration-300 mb-4" %>
        <h2 class="text-xl font-sans font-bold text-white tracking-wide">KASSEH</h2>
      <% end %>
    </div>

    <!-- Content Card -->
    <div class="bg-white/10 backdrop-blur-md border border-charcoal-700/50 rounded-lg shadow-2xl p-8 md:p-12 mb-8">
      <div class="mb-8 text-center">
        <h1 class="text-3xl md:text-4xl font-sans font-bold text-white mb-3">Terms of Service</h1>
        <p class="text-charcoal-300 text-sm">Last updated: <%= Time.current.strftime("%B %d, %Y") %></p>
      </div>

      <div class="prose prose-invert max-w-none">
        <section class="mb-8">
          <h2 class="text-2xl font-sans font-bold text-white mb-4">1. Acceptance of Terms</h2>
          <p class="text-charcoal-200 leading-relaxed">By accessing or using kasseh.com ("the Site"), you agree to be bound by these Terms of Service. If you do not agree to these terms, please do not use the Site.</p>
        </section>

        <section class="mb-8">
          <h2 class="text-2xl font-sans font-bold text-white mb-4">2. Description of Service</h2>
          <p class="text-charcoal-200 leading-relaxed mb-3">Kasseh.com is a personal website that provides:</p>
          <ul class="list-disc list-inside text-charcoal-200 space-y-2 ml-4">
            <li>Personal and professional information about Quentin Kasseh</li>
            <li>Writing and articles</li>
            <li>Portfolio and project information</li>
            <li>Restricted account access for authorized users only</li>
          </ul>
        </section>

        <section class="mb-8">
          <h2 class="text-2xl font-sans font-bold text-white mb-4">3. Account Access</h2>
          <p class="text-charcoal-200 leading-relaxed mb-3">Account creation and access is restricted to:</p>
          <ul class="list-disc list-inside text-charcoal-200 space-y-2 ml-4">
            <li>Users with @kasseh.com email addresses</li>
            <li>Individuals explicitly authorized by the site owner</li>
          </ul>
          <p class="text-charcoal-200 leading-relaxed mt-3">You are responsible for maintaining the security of your account credentials and for all activities that occur under your account.</p>
        </section>

        <section class="mb-8">
          <h2 class="text-2xl font-sans font-bold text-white mb-4">4. Acceptable Use</h2>
          <p class="text-charcoal-200 leading-relaxed mb-3">You agree not to:</p>
          <ul class="list-disc list-inside text-charcoal-200 space-y-2 ml-4">
            <li>Use the Site for any illegal purpose</li>
            <li>Attempt to gain unauthorized access to any part of the Site</li>
            <li>Interfere with or disrupt the Site's functionality</li>
            <li>Share your account credentials with unauthorized parties</li>
            <li>Attempt to reverse engineer or extract source code from the Site</li>
          </ul>
        </section>

        <section class="mb-8">
          <h2 class="text-2xl font-sans font-bold text-white mb-4">5. Intellectual Property</h2>
          <p class="text-charcoal-200 leading-relaxed">All content on this Site, including text, images, logos, and code, is the property of Quentin Kasseh or licensed to kasseh.com and is protected by copyright and other intellectual property laws. You may not reproduce, distribute, or create derivative works without express written permission.</p>
        </section>

        <section class="mb-8">
          <h2 class="text-2xl font-sans font-bold text-white mb-4">6. Third-Party Services</h2>
          <p class="text-charcoal-200 leading-relaxed mb-3">The Site may integrate with third-party services such as:</p>
          <ul class="list-disc list-inside text-charcoal-200 space-y-2 ml-4">
            <li>Google OAuth for authentication</li>
            <li>Apple Sign In for authentication</li>
            <li>Analytics services</li>
          </ul>
          <p class="text-charcoal-200 leading-relaxed mt-3">Your use of these services is subject to their respective terms and privacy policies.</p>
        </section>

        <section class="mb-8">
          <h2 class="text-2xl font-sans font-bold text-white mb-4">7. Limitation of Liability</h2>
          <p class="text-charcoal-200 leading-relaxed mb-3">TO THE MAXIMUM EXTENT PERMITTED BY LAW:</p>
          <ul class="list-disc list-inside text-charcoal-200 space-y-2 ml-4">
            <li>THE SITE IS PROVIDED "AS IS" WITHOUT WARRANTIES OF ANY KIND</li>
            <li>WE ARE NOT LIABLE FOR ANY INDIRECT, INCIDENTAL, OR CONSEQUENTIAL DAMAGES ARISING FROM YOUR USE OF THE SITE</li>
            <li>WE ARE NOT RESPONSIBLE FOR ANY INTERRUPTIONS OR DATA LOSS</li>
          </ul>
        </section>

        <section class="mb-8">
          <h2 class="text-2xl font-sans font-bold text-white mb-4">8. Account Termination</h2>
          <p class="text-charcoal-200 leading-relaxed">We reserve the right to suspend or terminate your account at any time for violations of these Terms or for any other reason at our discretion. You may delete your account at any time from your profile settings.</p>
        </section>

        <section class="mb-8">
          <h2 class="text-2xl font-sans font-bold text-white mb-4">9. Changes to Terms</h2>
          <p class="text-charcoal-200 leading-relaxed">We may modify these Terms at any time. Material changes will be communicated via email or through the Site. Continued use after changes constitutes acceptance of the modified Terms.</p>
        </section>

        <section class="mb-8">
          <h2 class="text-2xl font-sans font-bold text-white mb-4">10. Privacy</h2>
          <p class="text-charcoal-200 leading-relaxed">Your use of the Site is also governed by our <%= link_to "Privacy Policy", privacy_path, class: "text-gold-500 hover:text-gold-400 transition-colors underline" %>.</p>
        </section>

        <section class="mb-8">
          <h2 class="text-2xl font-sans font-bold text-white mb-4">11. Governing Law</h2>
          <p class="text-charcoal-200 leading-relaxed">These Terms are governed by the laws of the United States without regard to conflict of law provisions.</p>
        </section>

        <section class="mb-8">
          <h2 class="text-2xl font-sans font-bold text-white mb-4">12. Contact</h2>
          <p class="text-charcoal-200 leading-relaxed mb-3">For questions about these Terms, please contact:</p>
          <ul class="list-none text-charcoal-200 space-y-2">
            <li><strong class="text-white">Email:</strong> <a href="mailto:support@kasseh.com" class="text-gold-500 hover:text-gold-400 transition-colors underline">support@kasseh.com</a></li>
            <li><strong class="text-white">Website:</strong> <a href="https://www.kasseh.com" class="text-gold-500 hover:text-gold-400 transition-colors underline">https://www.kasseh.com</a></li>
          </ul>
        </section>
      </div>
    </div>

    <!-- Back to home link -->
    <div class="text-center mb-8">
      <%= link_to root_path, class: "inline-flex items-center text-charcoal-400 hover:text-gold-500 transition-all duration-300 group" do %>
        <svg class="w-4 h-4 mr-2 transition-transform duration-300 group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        Back to home
      <% end %>
    </div>

    <!-- Footer -->
    <footer class="text-center text-charcoal-400 text-sm pb-8">
      <div class="flex items-center justify-center space-x-2">
        <span>&copy; <%= Time.current.year %></span>
        <%= image_tag "kasseh-logo-small.png", alt: "", class: "w-4 h-4 opacity-60 inline-block" %>
        <span>Kasseh</span>
        <span class="text-charcoal-600">·</span>
        <%= link_to "Privacy", privacy_path, class: "hover:text-gold-500 transition-colors duration-300" %>
        <span class="text-charcoal-600">·</span>
        <%= link_to "Terms", terms_path, class: "hover:text-gold-500 transition-colors duration-300" %>
      </div>
    </footer>
  </div>
  </div>
</div>
<%= render 'shared/auth_scripts' %>
