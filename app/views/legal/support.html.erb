<% content_for :title, "Contact · Kasseh" %>
<% content_for :skip_navigation, true %>
<% content_for :body_class, "auth-page-body" %>

<div class="min-h-screen bg-gradient-to-br from-charcoal-900 via-charcoal-800 to-charcoal-900 px-4 py-12">
  <div class="max-w-3xl mx-auto">
    <!-- Logo -->
    <div class="text-center mb-12">
      <%= link_to root_path, class: "inline-block" do %>
        <%= image_tag "kasseh-logo.png", alt: "Kasseh", class: "w-16 h-16 mx-auto opacity-90 hover:opacity-100 transition-opacity duration-300 mb-4" %>
        <h2 class="text-xl font-sans font-bold text-white tracking-wide">KASSEH</h2>
      <% end %>
    </div>

    <!-- Content Card -->
    <div class="bg-white/10 backdrop-blur-md border border-charcoal-700/50 rounded-lg shadow-2xl p-8 md:p-12 mb-8">
      <div class="mb-8 text-center">
        <h1 class="text-3xl md:text-4xl font-sans font-bold text-white mb-3">Get in Touch</h1>
        <p class="text-charcoal-300">Have questions or need assistance? Reach out below.</p>
      </div>

      <div class="prose prose-invert max-w-none">
        <section class="mb-8">
          <h2 class="text-2xl font-sans font-bold text-white mb-4">Contact Information</h2>
          <div class="space-y-4 text-charcoal-200">
            <div>
              <h3 class="text-lg font-sans font-semibold text-white mb-2">General Inquiries</h3>
              <p><strong class="text-white">Email:</strong> <a href="mailto:quentin@kasseh.com" class="text-gold-500 hover:text-gold-400 transition-colors underline">quentin@kasseh.com</a></p>
            </div>

            <div>
              <h3 class="text-lg font-sans font-semibold text-white mb-2">Technical Support</h3>
              <p><strong class="text-white">Email:</strong> <a href="mailto:support@kasseh.com" class="text-gold-500 hover:text-gold-400 transition-colors underline">support@kasseh.com</a></p>
              <p class="text-sm text-charcoal-300 mt-1">For account or technical issues</p>
            </div>

            <div>
              <h3 class="text-lg font-sans font-semibold text-white mb-2">Connect Online</h3>
              <ul class="list-none space-y-2">
                <li><strong class="text-white">X (Twitter):</strong> <a href="https://twitter.com/quentinkasseh" target="_blank" rel="noopener" class="text-gold-500 hover:text-gold-400 transition-colors underline">@quentinkasseh</a></li>
                <li><strong class="text-white">LinkedIn:</strong> <a href="https://www.linkedin.com/in/quentink" target="_blank" rel="noopener" class="text-gold-500 hover:text-gold-400 transition-colors underline">linkedin.com/in/quentink</a></li>
                <li><strong class="text-white">Syntaxia:</strong> <a href="https://www.syntaxia.com" target="_blank" rel="noopener" class="text-gold-500 hover:text-gold-400 transition-colors underline">syntaxia.com</a></li>
              </ul>
            </div>
          </div>
        </section>

        <section class="mb-8">
          <h2 class="text-2xl font-sans font-bold text-white mb-4">Frequently Asked Questions</h2>

          <div class="space-y-6">
            <div>
              <h3 class="text-lg font-sans font-semibold text-white mb-2">How do I reset my password?</h3>
              <p class="text-charcoal-200">Visit the <%= link_to "password reset page", new_password_path, class: "text-gold-500 hover:text-gold-400 transition-colors underline" %> and enter your email address. You'll receive instructions to reset your password.</p>
            </div>

            <div>
              <h3 class="text-lg font-sans font-semibold text-white mb-2">How do I delete my account?</h3>
              <p class="text-charcoal-200">You can delete your account from your <%= link_to "profile page", profile_path, class: "text-gold-500 hover:text-gold-400 transition-colors underline" %>. This action is permanent and will remove all your data.</p>
            </div>

            <div>
              <h3 class="text-lg font-sans font-semibold text-white mb-2">Who can create an account?</h3>
              <p class="text-charcoal-200">Account creation is restricted to users with @kasseh.com email addresses. If you're a family member and need assistance, please email <a href="mailto:support@kasseh.com" class="text-gold-500 hover:text-gold-400 transition-colors underline">support@kasseh.com</a>.</p>
            </div>
          </div>
        </section>

        <div class="mt-8 p-6 bg-gold-500/10 border border-gold-500/30 rounded-md">
          <p class="text-gold-200 text-center mb-2"><strong>Need immediate help?</strong></p>
          <p class="text-gold-300/80 text-center text-sm">Email us at <a href="mailto:support@kasseh.com" class="text-gold-400 hover:text-gold-300 underline transition-colors">support@kasseh.com</a> and we'll respond as soon as possible.</p>
        </div>
      </div>
    </div>

    <!-- Back to home link -->
    <div class="text-center mb-8">
      <%= link_to root_path, class: "inline-flex items-center text-charcoal-400 hover:text-white transition-colors duration-300" do %>
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        Back to home
      <% end %>
    </div>

    <!-- Footer -->
    <footer class="text-center text-charcoal-400 text-sm space-y-2 pb-8">
      <div class="inline-flex items-center justify-center space-x-2">
        <span>&copy; <%= Time.current.year %></span>
        <%= image_tag "kasseh-logo-small.png", alt: "", class: "w-4 h-4 opacity-60 inline-block mx-1" %>
        <span>Kasseh</span>
      </div>
      <div class="flex items-center justify-center space-x-4">
        <%= link_to "Privacy", privacy_path, class: "hover:text-gold-500 transition-colors duration-300" %>
        <span class="text-charcoal-600">·</span>
        <%= link_to "Terms", terms_path, class: "hover:text-gold-500 transition-colors duration-300" %>
      </div>
    </footer>
  </div>
</div>
