<header class="site-header" data-controller="mobile-menu">
  <div class="site-header__inner">
    <a href="/" class="site-logo">
      <div class="auth-page__logo-text">
        Transfer<span style="color: var(--color-accent);">Chat</span>.ai
      </div>
      <span class="site-logo__tagline">Send & fetch files where work happens</span>
    </a>
    
    <button type="button" class="site-header__toggle" 
            data-mobile-menu-target="toggle" 
            data-action="click->mobile-menu#toggle"
            aria-expanded="false"
            aria-label="Toggle navigation menu">
      <span></span>
      <span></span>
      <span></span>
    </button>
    
    <nav class="site-nav" aria-label="Primary" data-mobile-menu-target="menu">
      <% if authenticated? %>
        <%= link_to "Dashboard", connections_path, class: "site-nav__link" %>
        <%= link_to "Logout", session_path, method: :delete, data: { turbo_method: :delete }, class: "site-nav__cta" %>
      <% else %>
        <%= link_to "Login", new_session_path, class: "site-nav__link" %>
        <%= link_to "Start free", new_registration_path, class: "site-nav__cta" %>
      <% end %>
    </nav>
  </div>
</header>
