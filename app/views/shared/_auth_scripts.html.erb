<style>
  .gradient-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    mix-blend-mode: screen;
    pointer-events: none;
  }
  .gradient-orb-1 {
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(197, 141, 71, 0.15) 0%, transparent 70%);
    top: 10%;
    left: 15%;
    animation: orb-drift-1 25s ease-in-out infinite;
  }
  .gradient-orb-2 {
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(212, 169, 98, 0.1) 0%, transparent 70%);
    bottom: 15%;
    right: 20%;
    animation: orb-drift-2 30s ease-in-out infinite;
  }
  .gradient-orb-3 {
    width: 350px;
    height: 350px;
    background: radial-gradient(circle, rgba(165, 114, 58, 0.12) 0%, transparent 70%);
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    animation: orb-drift-3 35s ease-in-out infinite;
  }
  @keyframes orb-drift-1 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(80px, -40px) scale(1.1); }
    66% { transform: translate(-40px, 80px) scale(0.9); }
  }
  @keyframes orb-drift-2 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(-100px, 60px) scale(0.9); }
    66% { transform: translate(60px, -80px) scale(1.1); }
  }
  @keyframes orb-drift-3 {
    0%, 100% { transform: translate(-50%, -50%) scale(1); }
    33% { transform: translate(calc(-50% + 40px), calc(-50% + 100px)) scale(1.1); }
    66% { transform: translate(calc(-50% - 80px), calc(-50% - 40px)) scale(0.9); }
  }
  .bg-gradient-radial-custom {
    background: radial-gradient(circle at 50% 50%, transparent 0%, rgba(10, 10, 12, 0.4) 50%, rgba(10, 10, 12, 0.8) 100%);
  }
  #spotlight {
    background: radial-gradient(
      600px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
      rgba(212, 169, 98, 0.06),
      transparent 40%
    );
  }
  #spotlight.active { opacity: 1; }
</style>

<script>
  class ParticleSystem {
    constructor(canvas) {
      this.canvas = canvas;
      this.ctx = canvas.getContext('2d');
      this.particles = [];
      this.particleCount = 50;
      this.resize();
      this.init();
      this.animate();
      window.addEventListener('resize', () => this.resize());
    }
    resize() {
      this.canvas.width = window.innerWidth;
      this.canvas.height = window.innerHeight;
    }
    init() {
      this.particles = [];
      for (let i = 0; i < this.particleCount; i++) {
        this.particles.push({
          x: Math.random() * this.canvas.width,
          y: Math.random() * this.canvas.height,
          size: Math.random() * 2 + 0.5,
          speedX: (Math.random() - 0.5) * 0.3,
          speedY: (Math.random() - 0.5) * 0.3,
          opacity: Math.random() * 0.5 + 0.2
        });
      }
    }
    update() {
      this.particles.forEach(particle => {
        particle.x += particle.speedX;
        particle.y += particle.speedY;
        if (particle.x < 0) particle.x = this.canvas.width;
        if (particle.x > this.canvas.width) particle.x = 0;
        if (particle.y < 0) particle.y = this.canvas.height;
        if (particle.y > this.canvas.height) particle.y = 0;
        particle.opacity = 0.2 + Math.sin(Date.now() * 0.001 + particle.x) * 0.2;
      });
    }
    draw() {
      this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);
      this.particles.forEach(particle => {
        this.ctx.beginPath();
        this.ctx.arc(particle.x, particle.y, particle.size, 0, Math.PI * 2);
        this.ctx.fillStyle = `rgba(212, 169, 98, ${particle.opacity})`;
        this.ctx.fill();
      });
      this.particles.forEach((p1, i) => {
        this.particles.slice(i + 1).forEach(p2 => {
          const dx = p1.x - p2.x;
          const dy = p1.y - p2.y;
          const distance = Math.sqrt(dx * dx + dy * dy);
          if (distance < 120) {
            this.ctx.beginPath();
            this.ctx.moveTo(p1.x, p1.y);
            this.ctx.lineTo(p2.x, p2.y);
            const opacity = (1 - distance / 120) * 0.1;
            this.ctx.strokeStyle = `rgba(212, 169, 98, ${opacity})`;
            this.ctx.lineWidth = 0.5;
            this.ctx.stroke();
          }
        });
      });
    }
    animate() {
      this.update();
      this.draw();
      requestAnimationFrame(() => this.animate());
    }
  }

  document.addEventListener('DOMContentLoaded', function() {
    const canvas = document.getElementById('particles');
    if (canvas) new ParticleSystem(canvas);
    
    const spotlight = document.getElementById('spotlight');
    let isActive = false;
    document.addEventListener('mousemove', (e) => {
      if (!isActive) {
        spotlight.classList.add('active');
        isActive = true;
      }
      spotlight.style.setProperty('--mouse-x', `${e.clientX}px`);
      spotlight.style.setProperty('--mouse-y', `${e.clientY}px`);
    });
  });
</script>
