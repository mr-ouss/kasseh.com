#!/usr/bin/env bash
# Local CI runner - runs the same checks as GitHub Actions CI
# Usage: bin/ci [--skip-tests]

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Counters
PASSED=0
FAILED=0
SKIPPED=0

echo -e "${BLUE}╔════════════════════════════════════════════════════════╗${NC}"
echo -e "${BLUE}║                Local CI Runner                         ║${NC}"
echo -e "${BLUE}╚════════════════════════════════════════════════════════╝${NC}"
echo ""

run_check() {
  local name="$1"
  local command="$2"
  
  echo -e "${YELLOW}▶ Running: ${name}${NC}"
  
  if eval "$command" > /tmp/ci_output.log 2>&1; then
    echo -e "${GREEN}✓ ${name} passed${NC}"
    PASSED=$((PASSED + 1))
  else
    echo -e "${RED}✗ ${name} failed${NC}"
    echo ""
    cat /tmp/ci_output.log
    echo ""
    FAILED=$((FAILED + 1))
  fi
  echo ""
}

skip_check() {
  local name="$1"
  echo -e "${YELLOW}⊘ ${name} skipped${NC}"
  SKIPPED=$((SKIPPED + 1))
  echo ""
}

# Parse arguments
SKIP_TESTS=false
for arg in "$@"; do
  case $arg in
    --skip-tests)
      SKIP_TESTS=true
      shift
      ;;
  esac
done

# Job 1: Security scan (Brakeman) - skip libs to avoid RailsRocket warnings
run_check "Security scan (Brakeman)" "bin/brakeman --no-pager --skip-libs"

# Job 2: JavaScript security audit (skip if SSL issues)
if bin/importmap audit > /dev/null 2>&1; then
  run_check "JavaScript dependencies audit" "bin/importmap audit"
else
  echo -e "${YELLOW}⊘ JavaScript dependencies audit skipped (network/SSL issues)${NC}"
  echo ""
fi

# Job 3: Linting (RuboCop)
run_check "Code linting (RuboCop)" "bin/rubocop"

# Job 4: Tests
if [ "$SKIP_TESTS" = true ]; then
  skip_check "Tests (skipped by --skip-tests flag)"
else
  # Check if 1Password CLI is available
  if ! command -v op &> /dev/null; then
    echo -e "${RED}✗ 1Password CLI not found${NC}"
    echo "  Install from: https://developer.1password.com/docs/cli/get-started/"
    echo "  Or run: brew install --cask 1password-cli"
    echo ""
    skip_check "Tests (1Password CLI required)"
  else
    # Check if signed in to 1Password
    if ! op account get &> /dev/null; then
      echo -e "${YELLOW}⚠ Not signed in to 1Password${NC}"
      echo "  Run: eval \$(op signin)"
      echo ""
      skip_check "Tests (1Password authentication required)"
    else
      echo -e "${YELLOW}▶ Running: Tests with coverage${NC}"
      
      # Set up test database
      RAILS_ENV=test bin/rails db:test:prepare
      
      # Run tests with coverage (DISABLE_SPRING=1 for clean test runs)
      if DISABLE_SPRING=1 RAILS_ENV=test COVERAGE=true op run --env-file=.github/workflows/.env.test -- bin/rails test > /tmp/ci_output.log 2>&1; then
        echo -e "${GREEN}✓ Tests passed${NC}"
        PASSED=$((PASSED + 1))
        
        # Show coverage report if available
        if [ -f coverage/.last_run.json ]; then
          COVERAGE=$(ruby -rjson -e "puts JSON.parse(File.read('coverage/.last_run.json'))['result']['line']")
          echo -e "${BLUE}  Coverage: ${COVERAGE}%${NC}"
          
          # Check threshold
          THRESHOLD=50
          if (( $(echo "$COVERAGE < $THRESHOLD" | bc -l) )); then
            echo -e "${YELLOW}  ⚠️  Coverage is below ${THRESHOLD}% threshold${NC}"
          else
            echo -e "${GREEN}  ✅ Coverage meets ${THRESHOLD}% threshold${NC}"
          fi
        fi
      else
        echo -e "${RED}✗ Tests failed${NC}"
        echo ""
        cat /tmp/ci_output.log
        echo ""
        FAILED=$((FAILED + 1))
      fi
      echo ""
    fi
  fi
fi

# Summary
echo -e "${BLUE}╔════════════════════════════════════════════════════════╗${NC}"
echo -e "${BLUE}║                    CI Summary                          ║${NC}"
echo -e "${BLUE}╚════════════════════════════════════════════════════════╝${NC}"
echo ""
echo -e "${GREEN}✓ Passed:  ${PASSED}${NC}"
echo -e "${RED}✗ Failed:  ${FAILED}${NC}"
echo -e "${YELLOW}⊘ Skipped: ${SKIPPED}${NC}"
echo ""

if [ $FAILED -gt 0 ]; then
  echo -e "${RED}❌ CI Failed${NC}"
  exit 1
else
  echo -e "${GREEN}✅ CI Passed${NC}"
  exit 0
fi
