# Kamal Secrets Configuration
#
# Secrets defined here are available for reference under registry/password, env/secret,
# builder/secrets, and accessories/*/env/secret in config/deploy.yml.
#
# IMPORTANT: All secrets should be pulled from password manager, ENV, or a file.
# DO NOT ENTER RAW CREDENTIALS HERE! This file needs to be safe for git.
#
# 1Password Integration:
# ----------------------
# Secrets are loaded from 1Password using the `op run` command:
#
#   Local deployment:
#     op run --env-file .github/workflows/.env.deploy -- kamal deploy
#
#   CI/CD (GitHub Actions):
#     Secrets are loaded automatically via the deploy workflow
#
# The .github/workflows/.env.deploy file contains references to your 1Password vault.
# Update that file with your vault name (replace "Kasseh.com" with your vault name).

# Registry credentials
# These are read from environment variables loaded by `op run` or set in CI
REGISTRY_PASSWORD=${REGISTRY_PASSWORD}
REGISTRY_USERNAME=${REGISTRY_USERNAME}

# Rails master key
# Read from environment in CI, or fall back to config/master.key locally
RAILS_MASTER_KEY=${RAILS_MASTER_KEY:-$(cat config/master.key 2>/dev/null)}

# Version info
# Set by CI/CD, or defaults for local development
APP_VERSION=${APP_VERSION:-development}
DEPLOYED_AT=${DEPLOYED_AT:-$(date -u +%Y-%m-%dT%H:%M:%SZ)}

# SMTP credentials
# Read from environment variables (via op run or CI)
SMTP_USERNAME=${SMTP_USERNAME}
SMTP_PASSWORD=${SMTP_PASSWORD}
SMTP_SERVER=${SMTP_SERVER}

# OAuth credentials (loaded from environment)
GITHUB_CLIENT_ID=${GITHUB_CLIENT_ID}
GITHUB_CLIENT_SECRET=${GITHUB_CLIENT_SECRET}
GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID}
GOOGLE_CLIENT_SECRET=${GOOGLE_CLIENT_SECRET}
APPLE_CLIENT_ID=${APPLE_CLIENT_ID}
APPLE_TEAM_ID=${APPLE_TEAM_ID}
APPLE_KEY_ID=${APPLE_KEY_ID}
APPLE_PRIVATE_KEY=${APPLE_PRIVATE_KEY}

# Add your own secrets below
# They will be available in your Rails app via ENV['SECRET_NAME']
